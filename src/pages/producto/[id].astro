---
/**
 * Ficha de producto.
 *
 * El manual §4 pide tres bloques: para qué sirve, cómo se usa, cuánto rinde.
 * Se dejó solo el tercero, por decisión de la dueña: su clienta ya sabe para
 * qué sirve un esmalte y cómo se aplica antes de entrar al catálogo — no hace
 * falta explicárselo. Lo que sí decide la compra es el dato práctico: cuánto
 * trae el frasco, o que las limas van dos por un dólar. Ese dato sigue abierto,
 * no en acordeón, porque es justo el argumento que explica el precio.
 *
 * El nombre va en Didot a 32 px: es la única superficie donde el nombre del
 * producto alcanza el mínimo de 24 px que permite la tipografía de titulares.
 */

import Base from "../../layouts/Base.astro";
import Encabezado from "../../components/Encabezado.astro";
import PieDePagina from "../../components/PieDePagina.astro";
import Bolsa from "../../components/Bolsa.astro";
import Precio from "../../components/Precio.astro";
import Swatches from "../../components/Swatches.astro";
import BarraProducto from "../../components/BarraProducto.astro";
import Cantidad from "../../components/Cantidad.astro";
import Icono from "../../components/Icono.astro";
import productos from "../../data/productos.json";

export function getStaticPaths() {
  return productos.map((p) => ({
    params: { id: p.producto_id.toLowerCase() },
    props: { p },
  }));
}

const { p } = Astro.props;

const CATEGORIAS = { unas: "Uñas", herramientas: "Herramientas", pestanas: "Pestañas y cejas", facial: "Cuidado facial", maquillaje: "Maquillaje", cuerpo: "Cuerpo y spa", cabello: "Cabello" };

const primera = p.variantes[0];
const srcset = (src: string) =>
  [400, 550, 700]
    .map((w) => `${src.replace(".webp", `-${w}.webp`)} ${w}w`)
    .concat(`${src} 1000w`)
    .join(", ");

const monto = new Intl.NumberFormat("es-VE", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

const bloques = [{ titulo: "Cuánto rinde", texto: p.rendimiento }].filter((b) => b.texto);
---

<Base titulo={p.nombre} descripcion={p.descripcion}>
  <div class="app-shell">
    <div class="app-main">
      <div class="hidden md:block">
        <Encabezado />
      </div>

      <main id="contenido" class="pb-28 md:pb-12">
        <div class="bg-[#fdf1ec]">
          <div class="contenedor flex items-center justify-between py-2 md:hidden">
            <a
              href={`/?categoria=${p.categoria}`}
              class="presionable inline-flex h-[44px] w-[44px] items-center justify-center rounded-xl bg-papel text-ciruela shadow-[0_0_0_1px_rgba(43,10,38,0.08)]"
              aria-label={`Volver a ${CATEGORIAS[p.categoria as keyof typeof CATEGORIAS]}`}
            >
              <Icono nombre="chevron" tamano={18} class="rotate-90" />
            </a>
            <button
              type="button"
              data-bolsa-abrir
              aria-label="Ver el pedido"
              class="presionable relative inline-flex h-[44px] w-[44px] items-center justify-center rounded-xl bg-papel text-ciruela shadow-[0_0_0_1px_rgba(43,10,38,0.08)]"
            >
              <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none">
                <path d="M6 7h12l-1 13H7L6 7zM9 7V6a3 3 0 0 1 6 0v1" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
              </svg>
              <span
                data-bolsa-cuenta
                class="absolute -top-1 -right-1 hidden min-h-[18px] min-w-[18px] items-center justify-center rounded-full bg-magenta px-1 text-[11px] font-bold text-crema tabular-nums [&:not(.hidden)]:flex"
                >0</span
              >
            </button>
          </div>
          <div class="contenedor hidden py-2 md:block">
            <a
              href={`/?categoria=${p.categoria}`}
              class="presionable inline-flex h-[44px] items-center gap-1 font-sans text-[14px] font-semibold text-purpura"
            >
              <Icono nombre="chevron" tamano={16} class="rotate-90" />
              {CATEGORIAS[p.categoria as keyof typeof CATEGORIAS]}
            </a>
          </div>
          <button
            type="button"
            data-ampliar
            class="block w-full cursor-zoom-in"
            aria-label="Ver la foto en grande"
          >
            <img
              data-foto
              src={primera.imagenes[0]}
              srcset={srcset(primera.imagenes[0])}
              sizes="(min-width: 1100px) 480px, 100vw"
              alt={`${p.nombre}${p.presentacion ? ` ${p.presentacion}` : ""}`}
              width="1000"
              height="1000"
              fetchpriority="high"
              decoding="async"
              class="mx-auto h-[220px] w-full max-w-[480px] object-contain p-2 md:h-auto md:aspect-square"
            />
          </button>
        </div>

        <div
          class="contenedor -mt-4 rounded-t-3xl bg-[#fffaf7] pt-5"
          data-producto
          data-id={p.producto_id}
          data-nombre={p.nombre}
          data-presentacion={p.presentacion ?? ""}
          data-precio={p.precio_divisa}
          data-referencia={p.precio_referencia}
          data-stock={p.stock ?? undefined}
        >
          <p class="font-sans text-[12px] font-bold tracking-wide text-purpura uppercase">
            {CATEGORIAS[p.categoria as keyof typeof CATEGORIAS]}{p.marca && <Fragment> · {p.marca}</Fragment>}
          </p>
          <h1 class="mt-1 font-didot text-[30px] leading-tight text-ciruela">{p.nombre}</h1>
          {p.presentacion && <p class="mt-1 font-sans text-[14px] text-ciruela/60">{p.presentacion}</p>}

          <div class="mt-3 flex items-end justify-between gap-3">
            <div class="min-w-0 flex-1">
              <Precio
                divisa={p.precio_divisa}
                referencia={p.precio_referencia}
                nota={p.nota_precio}
                tamano="ficha"
              />
            </div>
            <Cantidad nombre={p.nombre} max={p.stock ?? null} />
          </div>

          {
            p.variantes.length > 1 && (
              <div class="mt-3 border-t border-ciruela/10 pt-3">
                <p class="mb-2 font-sans text-[14px] font-bold text-ciruela">
                  {p.tipo_variante === "color" ? "Tono" : p.tipo_variante === "aroma" ? "Aroma" : p.tipo_variante === "tamano" ? "Tamaño" : "Variante"}
                </p>
                <Swatches variantes={p.variantes} tipo={p.tipo_variante} modo="selector" />
              </div>
            )
          }

          <p class="mt-3 font-sans text-[12px] text-ciruela/60">
            {
              p.foto_editada
                ? p.tipo_variante === "color"
                  ? "Foto editada a partir de la del producto real; el tono puede verse un poco distinto."
                  : "Foto editada a partir de la del producto real."
                : "Foto del producto real, sin retoque de color."
            }
          </p>

          <div class="mt-4" data-cta-principal>
            <button
              type="button"
              data-agregar
              class="presionable inline-flex min-h-[52px] w-full items-center justify-center rounded-2xl bg-magenta px-3 font-sans text-[16px] font-bold text-crema disabled:cursor-not-allowed disabled:opacity-40"
            >
              Agregar al pedido<span data-precio-total>&nbsp;· ${monto.format(p.precio_divisa)}</span>
            </button>
            <p class="mt-2 font-sans text-[13px] text-ciruela/60">
              Te confirmamos disponibilidad y cuándo lo tienes.
            </p>
          </div>

          <div class="mt-6 flex flex-col gap-4">
            {
              bloques.map((b) => (
                <section>
                  <h2 class="font-sans text-[14px] font-bold text-purpura">{b.titulo}</h2>
                  <p class="mt-1 max-w-[52ch] font-sans text-[16px] leading-relaxed text-ciruela/85">{b.texto}</p>
                </section>
              ))
            }
          </div>

          <p class="mt-6">
            <a
              href={`/?categoria=${p.categoria}`}
              class="inline-flex min-h-[44px] items-center font-sans text-[14px] font-semibold text-purpura"
            >
              Volver a {CATEGORIAS[p.categoria as keyof typeof CATEGORIAS]}
            </a>
          </p>
        </div>
      </main>

      <PieDePagina />
    </div>
    <Bolsa />
  </div>

  {/* ── Foto en grande ────────────────────────────────────────────────── */}
  <dialog
    data-lupa
    class="m-auto max-h-[90dvh] max-w-[90vw] bg-crema p-2 backdrop:bg-ciruela/60"
    aria-label={`${p.nombre} en grande`}
  >
    <img
      data-lupa-foto
      src={primera.imagenes[0]}
      alt=""
      loading="lazy"
      decoding="async"
      class="max-h-[80dvh] w-auto"
    />
    <button
      type="button"
      data-lupa-cerrar
      class="t-etiqueta mt-1 min-h-[44px] w-full text-ciruela/70 hover:text-ciruela"
    >
      Cerrar
    </button>
  </dialog>

  <BarraProducto producto={p} />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      name: p.nombre,
      description: p.descripcion,
      ...(p.marca ? { brand: { "@type": "Brand", name: p.marca } } : {}),
      category: CATEGORIAS[p.categoria as keyof typeof CATEGORIAS],
      image: p.variantes.map((v: any) => new URL(v.imagenes[0], Astro.site).href),
      ...(p.presentacion ? { size: p.presentacion } : {}),
      offers: {
        // con precio por opción: rango de precios (AggregateOffer) en vez de uno solo
        ...(p.variantes.some((v: any) => v.precio_divisa)
          ? {
              "@type": "AggregateOffer",
              lowPrice: Math.min(...p.variantes.map((v: any) => v.precio_divisa ?? p.precio_divisa)).toFixed(2),
              highPrice: Math.max(...p.variantes.map((v: any) => v.precio_divisa ?? p.precio_divisa)).toFixed(2),
              offerCount: p.variantes.length,
            }
          : { "@type": "Offer", price: p.precio_divisa.toFixed(2) }),
        priceCurrency: "USD",
        availability: p.disponible
          ? "https://schema.org/InStock"
          : "https://schema.org/OutOfStock",
        url: new URL(`/producto/${p.producto_id.toLowerCase()}`, Astro.site).href,
      },
    })}
  />

  <script>
    import "../../scripts/ficha.js";
  </script>
</Base>
