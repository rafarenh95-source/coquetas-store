---
/**
 * Los dos precios, siempre.
 *
 * Pagar en bolívares no es el mismo monto que pagar en divisa: el de
 * bolívares lleva el recargo (precio_referencia). El equivalente en Bs lo
 * rellena el script de la tasa al cargar. Nunca se hornea en el build.
 */

interface Props {
  divisa: number;
  referencia?: number | null;
  nota?: string | null;
  tamano?: "tarjeta" | "ficha";
}

const { divisa, referencia = null, nota = null, tamano = "tarjeta" } = Astro.props;

const monto = new Intl.NumberFormat("es-VE", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const enFicha = tamano === "ficha";
---

<div class="flex flex-col gap-[2px]">
  <p
    class:list={[
      "font-sans font-extrabold text-ciruela tabular-nums",
      enFicha ? "text-[30px] leading-none" : "text-[16px] leading-tight",
    ]}
    data-precio-divisa
  >
    ${monto.format(divisa)}
  </p>

  {
    referencia !== null && (
      <p class:list={["font-sans text-ciruela/80 tabular-nums", enFicha ? "text-[15px]" : "text-[12px] leading-snug"]}>
        <span data-precio-referencia class="font-semibold">
          ${monto.format(referencia)}
        </span>
        <span> en bolívares</span>
      </p>
    )
  }

  {
    referencia !== null && (
      <p
        class:list={[
          "hidden font-sans font-semibold text-ciruela/70 tabular-nums",
          enFicha ? "text-[14px]" : "text-[12px]",
        ]}
        data-bs
        data-referencia={referencia}
      >
        <span data-bs-monto />
      </p>
    )
  }

  {
    enFicha && (
      <p class="mt-1 hidden font-sans text-[12px] text-ciruela/60" data-bs-tasa-linea>
        <span data-bs-tasa />
      </p>
    )
  }

  {nota && <p class="font-sans text-[12px] text-ciruela/70">{nota}</p>}
</div>
