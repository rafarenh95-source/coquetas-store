---
/**
 * Barra de arriba, fija.
 *
 * En el teléfono: el logo, Información y la bolsa; debajo, el buscador.
 * En la computadora: logo, Catálogo, Información y el teléfono; el buscador
 * va en su propio renglón para que el texto quepa junto al pedido.
 * El pedido en la computadora va en el panel de la derecha, no en un ícono.
 */

import Logo from "./Logo.astro";
import Icono from "./Icono.astro";
import tienda from "../data/tienda.json";

const telefono = tienda.whatsapp
  ? `+${tienda.whatsapp.replace(/^(58)(\d{3})(\d{3})(\d{4})$/, "$1 $2 $3 $4")}`
  : null;

const enlaceWhatsapp = tienda.whatsapp
  ? `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(
      "Hola Coquetas Store, quiero hacer un pedido."
    )}`
  : null;

const icono =
  "presionable inline-flex h-[44px] w-[44px] items-center justify-center rounded-xl bg-papel text-ciruela shadow-[0_0_0_1px_rgba(43,10,38,0.08)]";
---

<header class="sticky top-0 z-40 border-b border-ciruela/10 bg-[#fffaf7] pt-[env(safe-area-inset-top)]">
  <div class="contenedor flex items-center gap-2 py-2 min-[1100px]:gap-4 min-[1100px]:py-3">
    <a href="/" class="shrink-0" aria-label={`${tienda.nombre} — inicio`}>
      <span class="min-[1100px]:hidden">
        <Logo version="horizontal" ancho={180} />
      </span>
      <span class="hidden min-[1100px]:block">
        <Logo version="horizontal" ancho={200} />
      </span>
    </a>

    <nav aria-label="Principal" class="ml-auto flex shrink-0 items-center gap-2 min-[1100px]:gap-4">
      <a
        href="/#catalogo"
        class="presionable hidden min-h-[44px] items-center font-sans text-[14px] font-semibold text-ciruela/80 hover:text-ciruela min-[1100px]:inline-flex"
      >
        Catálogo
      </a>
      <a
        href="/#informacion"
        aria-label="Información de la tienda"
        class={`${icono} min-[1100px]:h-auto min-[1100px]:w-auto min-[1100px]:bg-transparent min-[1100px]:px-0 min-[1100px]:shadow-none`}
      >
        <svg
          viewBox="0 0 24 24"
          width="19"
          height="19"
          aria-hidden="true"
          fill="none"
          class="min-[1100px]:hidden"
        >
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 11v6M12 8h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="hidden font-sans text-[14px] font-semibold text-ciruela/80 min-[1100px]:inline">Información</span>
      </a>
      {
        enlaceWhatsapp && telefono && (
          <a
            href={enlaceWhatsapp}
            target="_blank"
            rel="noopener"
            class="presionable hidden min-h-[44px] items-center font-sans text-[14px] font-semibold text-magenta min-[1100px]:inline-flex"
          >
            {telefono}
          </a>
        )
      }
      <button
        type="button"
        data-bolsa-abrir
        aria-label="La bolsa está vacía"
        class={`${icono} relative min-[1100px]:hidden`}
      >
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true" fill="none">
          <path
            d="M6 7h12l-1 13H7L6 7zM9 7V6a3 3 0 0 1 6 0v1"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
        <span
          data-bolsa-cuenta
          class="absolute -top-1 -right-1 hidden min-h-[18px] min-w-[18px] items-center justify-center rounded-full bg-magenta px-1 text-[11px] font-bold text-crema tabular-nums [&:not(.hidden)]:flex"
          >0</span
        >
      </button>
    </nav>
  </div>

  <form action="/" method="get" role="search" data-buscar class="contenedor pb-2">
    <label class="sr-only" for="buscar-catalogo-movil">Buscar productos</label>
    <div
      class="flex h-[48px] items-center gap-2 rounded-2xl bg-papel px-3 shadow-[0_0_0_1px_rgba(43,10,38,0.08)] focus-within:shadow-[0_0_0_2px_var(--color-magenta)]"
    >
      <Icono nombre="buscar" tamano={18} class="shrink-0 text-ciruela/60" />
      <input
        id="buscar-catalogo-movil"
        name="buscar"
        type="search"
        enterkeyhint="search"
        autocomplete="off"
        placeholder="Buscar esmaltes, gel, pestañas…"
          class="h-[44px] min-w-0 flex-1 border-0 bg-transparent font-sans text-[16px] text-ciruela outline-none placeholder:text-ciruela/50"
      />
      <button
        type="button"
        data-buscar-limpiar
        hidden
        aria-label="Borrar la búsqueda"
        class="presionable inline-flex h-[44px] w-[44px] shrink-0 items-center justify-center rounded-full text-ciruela/70"
      >
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </form>
</header>
