---
/**
 * Encabezado.
 *
 * Fondo crema porque el logo solo puede ir sobre crema o papel (manual §5).
 *
 * Los accesos que resuelven algo van aquí arriba: ir a la tienda, pedir por
 * WhatsApp, seguir en TikTok y ver la bolsa. En móvil y tablet son iconos para que
 * quepan junto al lockup completo — el manual pide 180 px de mínimo para el
 * horizontal, y con texto en los botones no cabrían.
 *
 * No todos caben a la vez en un teléfono angosto, así que se retiran en
 * orden de qué tan reemplazable es cada uno por otra vía: primero TikTok
 * (< 412 px), luego el mapa (< 360 px) — los dos siguen alcanzables desde el
 * pie. WhatsApp y la bolsa no se ocultan nunca: son los dos que resuelven la
 * compra. Sin este orden, el navegador ensancha el viewport para que quepa
 * el encabezado entero y la página se ve encogida.
 *
 * Cada botón mide 44 × 44, el mínimo para el dedo. Cuentas en el ancho más
 * justo de cada tramo (logo 180 + 8 de aire + botones de 44 con 4 entre sí):
 *   320 px → 2 botones = 280 de 288 disponibles
 *   360 px → 3 botones = 328 de 328
 *   412 px → 4 botones = 376 de 380
 */

import Logo from "./Logo.astro";
import Icono from "./Icono.astro";
import tienda from "../data/tienda.json";

const enlaces = [
  { texto: "Catálogo", href: "/#catalogo" },
  { texto: "Cómo comprar", href: "/#como-comprar" },
];

const consultaMapa = tienda.direccion
  ? `${tienda.direccion}, ${tienda.ciudad}, ${tienda.estado}, Venezuela`
  : `${tienda.nombre}, ${tienda.ciudad}, ${tienda.estado}, Venezuela`;

const enlaceMapa =
  tienda.mapa ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(consultaMapa)}`;

const enlaceWhatsapp = tienda.whatsapp
  ? `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(
      "Hola Coquetas Store, quiero hacer un pedido."
    )}`
  : null;

const enlaceTiktok = tienda.tiktok ? `https://www.tiktok.com/@${tienda.tiktok}` : null;

/* Sin utilidad de display: la pone cada acción, para que ocultar una no
   dependa del orden en que Tailwind escriba las clases. */
const accion =
  "presionable min-h-[44px] items-center justify-center gap-1 transition-colors duration-[var(--paso)]";
---

<header class="bg-crema">
  <div class="contenedor flex items-center justify-between gap-1 py-2 md:gap-2 md:py-3">
    <a href="/" class="shrink-0" aria-label={`${tienda.nombre} — inicio`}>
      <span class="md:hidden">
        <Logo version="horizontal" ancho={180} />
      </span>
      <span class="hidden md:block">
        <Logo version="horizontal" ancho={220} />
      </span>
    </a>

    <nav aria-label="Principal" class="flex shrink-0 items-center gap-[4px] md:gap-2">
      <ul class="hidden items-center gap-3 xl:flex">
        {
          enlaces.map((e) => (
            <li>
              <a
                href={e.href}
                class={`${accion} inline-flex t-etiqueta px-1 text-ciruela/70 hover:text-ciruela`}
              >
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>

      {/* Ir a la tienda */}
      <a
        href={enlaceMapa}
        target="_blank"
        rel="noopener"
        aria-label="Ver la tienda en el mapa"
        class={`${accion} hidden w-[44px] border border-ciruela/25 text-ciruela/75 min-[360px]:inline-flex hover:border-ciruela hover:text-ciruela lg:w-auto lg:px-2`}
        data-accion-mapa
      >
        <Icono nombre="ubicacion" tamano={19} />
        <span class="t-etiqueta hidden lg:inline">Tienda</span>
      </a>

      {/* Pedir por WhatsApp */}
      {
        enlaceWhatsapp && (
          <a
            href={enlaceWhatsapp}
            target="_blank"
            rel="noopener"
            aria-label="Pedir por WhatsApp"
            data-wa-referencia
            class={`${accion} inline-flex w-[44px] bg-magenta text-crema hover:bg-purpura lg:w-auto lg:px-2`}
          >
            <Icono nombre="whatsapp" tamano={19} />
            <span class="t-etiqueta hidden lg:inline">Pedir</span>
          </a>
        )
      }

      {/* Seguir en TikTok */}
      {
        enlaceTiktok && (
          <a
            href={enlaceTiktok}
            target="_blank"
            rel="noopener"
            aria-label="Ver Coquetas Store en TikTok"
            class={`${accion} hidden w-[44px] border border-ciruela/25 text-ciruela/75 min-[412px]:inline-flex hover:border-ciruela hover:text-ciruela lg:w-auto lg:px-2`}
          >
            <Icono nombre="tiktok" tamano={17} />
            <span class="t-etiqueta hidden lg:inline">TikTok</span>
          </a>
        )
      }

      <button
        type="button"
        data-bolsa-abrir
        aria-label="La bolsa está vacía"
        class={`${accion} relative inline-flex w-[44px] border border-ciruela/25 text-ciruela hover:border-ciruela hover:text-purpura lg:w-auto lg:px-2`}
      >
        <span class="t-etiqueta hidden lg:inline">Bolsa</span>
        <svg
          viewBox="0 0 20 20"
          width="19"
          height="19"
          aria-hidden="true"
          fill="none"
          class="lg:hidden"
        >
          <path
            d="M4 6.5h12l-1 10.5H5L4 6.5Zm3 0V5a3 3 0 0 1 6 0v1.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <span
          data-bolsa-cuenta
          class="t-etiqueta absolute -top-[2px] -right-[2px] hidden min-w-[18px] rounded-full bg-magenta px-[4px] py-[1px] text-center text-[10px] text-crema tabular-nums lg:static lg:min-w-[20px] lg:rounded-full lg:px-1 lg:py-[2px] lg:text-[12px]"
          >0</span
        >
      </button>
    </nav>
  </div>
</header>
