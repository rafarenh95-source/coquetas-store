---
/**
 * Catálogo — portada de categorías, luego la grilla de una categoría a la vez.
 *
 * Antes, la portada mostraba las 35 fichas de un jalón (filtradas por una
 * categoría desplegable). En el teléfono eso era mucho scroll para llegar al
 * pie de página: quien solo quería ver «Cómo comprar» o la ubicación tenía
 * que cruzar el catálogo entero primero.
 *
 * Ahora la portada muestra solo las categorías, como tarjetas grandes con
 * foto. Tocar una categoría revela su grilla completa; un enlace «Todas las
 * categorías» regresa. El buscador sigue siempre visible y, si se escribe
 * algo, salta directo a los resultados sin pasar por las categorías.
 *
 * Sin JavaScript se ven las dos cosas a la vez -- categorías arriba, la
 * grilla completa debajo -- que es un estado correcto y usable: ningún
 * producto queda inalcanzable, solo la página es más larga. Es el mismo
 * criterio que ya regía el buscador y la categoría antes de esto.
 *
 * Orden dentro de cada categoría: destacados primero, luego consumidora antes
 * que uso profesional. El recorrido por defecto es el de Rebeca.
 */

import TarjetaProducto from "./TarjetaProducto.astro";
import BannerTienda from "./BannerTienda.astro";
import FlechaCarrusel from "./FlechaCarrusel.astro";
import Icono from "./Icono.astro";
import productos from "../data/productos.json";
import tienda from "../data/tienda.json";

const CATEGORIAS_BASE = [
  { id: "unas", texto: "Uñas", icono: "unas" as const },
  { id: "herramientas", texto: "Herramientas", icono: "herramientas" as const },
  { id: "pestanas", texto: "Pestañas y cejas", icono: "pestanas" as const },
  { id: "facial", texto: "Cuidado facial", icono: "facial" as const },
  { id: "cuerpo", texto: "Cuerpo y spa", icono: "cuerpo" as const },
];

/* Foto de portada de cada categoría: la del primer producto destacado que
   tenga, o si no hay ninguno destacado en esa categoría, la del primero por
   orden. Así la tarjeta de categoría no depende de mantener una lista aparte
   -- solo de la misma bandera `destacado` que ya se usa en los datos. */
/* Cuando ningún producto de la categoría está destacado, la primera por orden
   puede no representarla bien (en pestañas saldría la almohada; en
   herramientas, la lima; la tijera suelta se veía pequeña). */
const FOTO_DE_CATEGORIA: Record<string, string> = {
  herramientas: "MG-CORTA-SHARP",
  pestanas: "MY-LIBRETA-PESTANAS",
};

const CATEGORIAS = CATEGORIAS_BASE.map((c) => {
  const deLaCategoria = productos.filter((p) => p.categoria === c.id);
  const conFoto =
    deLaCategoria.find((p) => p.producto_id === FOTO_DE_CATEGORIA[c.id]) ??
    deLaCategoria.find((p) => p.destacado) ??
    deLaCategoria[0];
  return {
    ...c,
    cantidad: deLaCategoria.length,
    imagen: conFoto?.variantes[0]?.imagenes[0] ?? null,
  };
});

/* «Favoritos de Coquetas»: los productos de la fila de la portada, en este
   orden. Los elige la dueña. Lista aparte y no la bandera «destacado» de los
   datos, porque esa bandera también decide la foto de cada categoría (el
   agua micelar salió de aquí pero sigue siendo la foto de Cuidado facial). */
const MUESTRA = [
  "MG-ESM-SEMI-10",
  "MG-GEL-COLOR-15",
  "MG-EXFOLIANTE",
  "MG-VELOTERAPIA",
  "MG-AGUA-MICELAR",
  "MG-POLYGEL",
  "CQ-MICROBLUSH",
  "MG-BODY-BUTTER",
  "MG-ACE-CUT-FLOR",
  "MG-AGUA-ROSAS",
  "CQ-SET-PINCELES",
  "MG-BOMBAS-EFERV",
  "EG-ESM-TRAD",
  "MG-GASAS-PESTANAS",
  "MB-BUILDER-GEL",
  "CQ-PALETA-EXFOLIANTE",
];
const muestra = MUESTRA.map((id) => productos.find((p) => p.producto_id === id)).filter(
  (p): p is (typeof productos)[number] => Boolean(p)
);
const TITULO_MUESTRA = "Favoritos de Coquetas";

/* Clases compartidas por los dos carruseles. La pista llega hasta el borde
   de la pantalla (su envoltorio se sale del contenedor) y el encaje se alinea
   con el margen del texto (scroll-padding), como en las tiendas de apps. */
const PISTA =
  "sin-riel flex snap-x snap-mandatory gap-2 overflow-x-auto overscroll-x-contain px-[var(--sangria)] scroll-px-[var(--sangria)] md:gap-3";
const SANGRE = "relative mt-2 -mx-[var(--sangria)]";
/* Tarjetas visibles a la vez: categorías 1,5 · 2,5 · 3,5 · 4,5; favoritos
   (solo la foto, más chicas) 2,5 · 3,5 · 3,5 · 3,5 (son cuatro: con más
   visibles cabrían todas y no habría nada que deslizar en la computadora). */
/* Categorías: tarjetas chicas con ícono, ~3 a la vista en el teléfono
   (decisión de la dueña) con un pedacito de la cuarta; nunca menos de 96 px,
   que es lo que pide «Herramientas» para caber en un renglón. En 320 px no
   caben tres: van dos y media (si no, la tercera quedaba cortada por 8 px). Desde 640 px
   caben las cinco y no hay nada que deslizar (las flechas se esconden solas). */
const PISTA_CATEGORIA =
  "sin-riel flex snap-x snap-mandatory gap-[12px] overflow-x-auto overscroll-x-contain px-[var(--sangria)] scroll-px-[var(--sangria)] md:gap-3";
const DIAPO_CATEGORIA =
  "flex min-w-0 shrink-0 snap-start basis-[calc((100%-12px)/2.4)] min-[360px]:basis-[max(96px,calc((100%-24px)/3.25))] sm:basis-[calc((100%-48px)/5)] md:basis-[calc((100%-96px)/5)]";
const DIAPO_MUESTRA =
  "flex min-w-0 shrink-0 snap-start basis-[calc((100%-32px)/2.5)] sm:basis-[calc((100%-48px)/3.5)] md:basis-[calc((100%-72px)/3.5)]";

/* Fotos de producto en 400 / 550 / 700 / 1000 px. */
const srcsetDe = (src: string) =>
  [400, 550, 700]
    .map((w) => `${src.replace(".webp", `-${w}.webp`)} ${w}w`)
    .concat(`${src} 1000w`)
    .join(", ");

const NOMBRES: Record<string, string> = {
  todo: "Todo",
  unas: "Uñas",
  herramientas: "Herramientas",
  pestanas: "Pestañas y cejas",
  facial: "Cuidado facial",
  cuerpo: "Cuerpo y spa",
};

/* El aviso de que esto es una muestra vive en dos momentos, no uno:
   arriba, una línea corta, solo para que nadie confunda la selección con el
   inventario completo. Abajo, después de recorrer la grilla entera, el
   argumento con el número real — que es cuando de verdad importa, porque es
   el momento en que quien no encontró lo suyo decide si pregunta o se va. El
   enlace no abre el chat en blanco: llega con el mensaje ya escrito. */
const enlaceListaCompleta = tienda.whatsapp
  ? `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(
      "Hola Coquetas Store, quiero ver la lista completa de productos disponibles."
    )}`
  : null;
---

<section id="catalogo" class="scroll-mt-2">
  {/* Decide la vista antes de que se dibuje nada. Si se esperaba al script
      del final, con ?categoria= en el enlace se pintaban primero las tarjetas
      de categoría y luego desaparecían: la página entera daba un salto (CLS
      0,89 medido en un teléfono lento). La regla de CSS que lee este atributo
      está en global.css; el script de abajo lo retira al tomar el control. */}
  <script is:inline define:vars={{ validas: Object.keys(NOMBRES) }}>
    var params = new URLSearchParams(location.search);
    var inicial = params.get("categoria");
    var buscando = (params.get("buscar") || "").trim();
    document.documentElement.dataset.vistaInicial =
      buscando || (inicial && validas.indexOf(inicial) > -1) ? "grilla" : "portada";
  </script>

  {/* Donde iba el título «Catálogo» va la cinta de fotos de la tienda
      (decisión de la dueña). El H1 sigue existiendo para el lector de
      pantalla y el buscador, pero no se ve. */}
  <h1 class="sr-only">Catálogo de Coquetas Store</h1>
  <BannerTienda />

  {/* El buscador ya no va aquí (decisión de la dueña): está arriba de todo
      dentro del menú, con su lupa. Al buscar se llega a la grilla con
      ?buscar=… (o sin recargar, si ya se está en la portada). */}

  {/* ── Portada: solo categorías ──────────────────────────────────────────
      Vista inicial con JavaScript. El script la esconde y muestra la grilla
      completa en cuanto se toca una categoría o se escribe en el buscador. */}
  <div id="vista-portada" class="contenedor mt-5 scroll-mt-[84px]">
    {/* ── Dos carruseles: «Favoritos de Coquetas» y «Categorías» ─────────
        Filas que se deslizan con el dedo (scroll-snap nativo: el navegador
        hace el deslizamiento y la inercia, así que va fluido hasta en un
        teléfono de gama baja). Siempre asoma media tarjeta de la siguiente.

        Avanzan solas de a una tarjeta con 1,3 s quietas entre avance y
        avance, y dan la vuelta sin fin. Se detienen al tocarlas, al pasar el
        ratón o al enfocarlas con el teclado, y no arrancan si el teléfono
        pide movimiento reducido. Sin botón de pausa (la dueña lo quitó de
        Favoritos); flechas a los lados (FlechaCarrusel). Las dos filas arrancan
        desfasadas para no moverse a la vez. Todo en scripts/carrusel.js.

        Sin JavaScript quedan filas deslizables a mano, sin controles. */}
    {
      muestra.length > 0 && (
        <div
          data-carrusel="muestra"
          role="region"
          aria-roledescription="carrusel"
          aria-labelledby="titulo-muestra"
          class="mb-6"
        >
          <div class="flex min-h-[44px] items-center justify-between gap-2">
            <p id="titulo-muestra" class="t-etiqueta text-purpura">{TITULO_MUESTRA}</p>
          </div>
          <div class={SANGRE}>
            <div data-carrusel-pista aria-live="off" class={PISTA}>
              {muestra.map((p, i) => (
                <div
                  role="group"
                  aria-roledescription="diapositiva"
                  aria-label={`${i + 1} de ${muestra.length}`}
                  data-carrusel-diapositiva
                  class={DIAPO_MUESTRA}
                >
                  {/* Solo la foto (decisión de la dueña): una muestra rápida.
                      Tocarla abre la ficha, donde están el precio y los tonos. */}
                  <a
                    href={`/producto/${p.producto_id.toLowerCase()}`}
                    class="presionable group block w-full bg-papel"
                  >
                    <div data-carrusel-foto class="aspect-square overflow-hidden">
                      <img
                        src={p.variantes[0].imagenes[0]}
                        srcset={srcsetDe(p.variantes[0].imagenes[0])}
                        sizes="(min-width: 1280px) 310px, (min-width: 768px) 26vw, (min-width: 640px) 27vw, 38vw"
                        alt={`${p.nombre}${p.presentacion ? ` ${p.presentacion}` : ""}`}
                        width="1000"
                        height="1000"
                        loading={i < 3 ? "eager" : "lazy"}
                        fetchpriority={i < 2 ? "high" : "auto"}
                        decoding="async"
                        class="h-full w-full object-contain p-1 transition-transform duration-[var(--paso-lento)] ease-[var(--curva)] group-hover:scale-[1.03]"
                      />
                    </div>
                  </a>
                </div>
              ))}
            </div>
            <FlechaCarrusel direccion="anterior" etiqueta="Favorito anterior" />
            <FlechaCarrusel direccion="siguiente" etiqueta="Favorito siguiente" />
          </div>
          <div data-carrusel-puntos aria-hidden="true" hidden class="mt-2 flex justify-center gap-[6px]"></div>
        </div>
      )
    }

    <div
      data-carrusel="categorias"
      data-sin-avance
      role="region"
      aria-roledescription="carrusel"
      aria-labelledby="titulo-categorias"
    >
      <div class="flex min-h-[44px] items-center justify-between gap-2">
        <p id="titulo-categorias" class="t-etiqueta text-purpura">Categorías</p>
      </div>
      <div class={SANGRE}>
        <div data-carrusel-pista aria-live="off" class={PISTA_CATEGORIA}>
          {
            CATEGORIAS.map((c, i) => (
              <div
                role="group"
                aria-roledescription="diapositiva"
                aria-label={`${i + 1} de ${CATEGORIAS.length}`}
                data-carrusel-diapositiva
                class={DIAPO_CATEGORIA}
              >
                {/* Ícono en vez de foto (decisión de la dueña): los mismos del
                    menú, en grande sobre un círculo crema. */}
                <a
                  href="#grilla"
                  data-categoria-tile={c.id}
                  class="presionable group flex w-full flex-col items-center gap-1 bg-papel px-[6px] pt-2 pb-[12px] text-center"
                >
                  <span
                    data-carrusel-foto
                    class="flex h-[60px] w-[60px] items-center justify-center rounded-full bg-crema text-purpura transition-transform duration-[var(--paso-lento)] ease-[var(--curva)] group-hover:scale-[1.06] md:h-[80px] md:w-[80px]"
                  >
                    <Icono nombre={c.icono} tamano={30} />
                  </span>
                  <span class="font-sans text-[13px] leading-tight font-semibold text-ciruela md:text-[15px]">
                    {c.texto}
                  </span>
                </a>
              </div>
            ))
          }
          {/* Sin tarjeta «Todo» (decisión de la dueña): los favoritos de arriba
              y el buscador cubren a quien quiere mirar sin elegir categoría. */}
        </div>
        <FlechaCarrusel direccion="anterior" etiqueta="Categoría anterior" />
        <FlechaCarrusel direccion="siguiente" etiqueta="Categoría siguiente" />
      </div>

    </div>
  </div>

  {/* ── Grilla: una categoría (o los resultados del buscador) a la vez ──── */}
  <div id="vista-grilla" class="contenedor mt-6 scroll-mt-[84px]">
    {/* Siempre en dos renglones (volver arriba, categoría debajo). Al cargar, el
        rótulo dice «Todo · 65 productos» y el script lo cambia enseguida: si
        compartían renglón, según el ancho del texto la fila crecía o encogía y la
        grilla entera daba un salto. */}
    <div class="mb-3 flex flex-col items-start border-t border-ciruela/15 pt-3">
      <a
        href="#vista-portada"
        data-volver
        class="presionable t-etiqueta inline-flex min-h-[44px] items-center gap-1 text-purpura underline decoration-1 underline-offset-2 transition-colors duration-[var(--paso)] hover:text-ciruela"
      >
        <Icono nombre="chevron" tamano={13} class="rotate-90" />
        Todas las categorías
      </a>
      <p id="categoria-nombre" class="t-etiqueta text-ciruela/60">
        Todo · {productos.length} productos
      </p>
    </div>

    {/* Un solo panel gobernado por buscador + categoría: aria-labelledby
        apunta al texto que dice en qué categoría está y cuántas hay, y el
        script lo mantiene al día. */}
    <div
      id="grilla"
      role="region"
      aria-labelledby="categoria-nombre"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-2 md:grid-cols-3 md:gap-3 lg:grid-cols-4"
    >
      {
        /* Ninguna tarjeta con prioridad: al cargar, la grilla está escondida
           detrás de las categorías, y una foto «eager» se descarga aunque no se
           vea — eran ~100 KB de fotos grandes que nadie miraba. Con carga
           diferida, el navegador las pide en cuanto la grilla aparece. */
        productos.map((p) => (
          <div data-categoria={p.categoria} class="contents">
            <TarjetaProducto producto={p} />
          </div>
        ))
      }
    </div>

    <p
      id="sin-resultados"
      class="t-cuerpo mt-6 hidden text-center text-ciruela/70"
      role="status"
    >
      No hay piezas que coincidan.
    </p>

    {/* Sin esto, quien usa lector de pantalla filtra o busca y no sabe si
        pasó algo ni cuántas piezas quedaron. */}
    <p class="sr-only" role="status" aria-live="polite" data-recuento></p>
  </div>

  {/* Cierre del catálogo: el argumento completo llega cuando ya se vio algo,
      no antes de empezar a mirar. Vive fuera de las dos vistas de arriba
      porque es válido en cualquiera de las dos. */}
  <div class="contenedor mt-10">
    <div class="mx-auto flex max-w-[38ch] flex-col items-center gap-3 border-t border-ciruela/15 pt-8 text-center">
      <p class="t-cuerpo text-ciruela/80">
        Esta es apenas una muestra. Pregúntanos por WhatsApp y te enviamos la
        lista completa: más de 200 productos disponibles.
      </p>
      {
        enlaceListaCompleta && (
          <a
            href={enlaceListaCompleta}
            target="_blank"
            rel="noopener"
            class="presionable t-etiqueta inline-flex min-h-[48px] items-center gap-1 bg-magenta px-4 text-crema transition-colors duration-[var(--paso)] hover:bg-purpura"
          >
            Pedir la lista completa
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import "../scripts/tarjetas.js";
  import "../scripts/carrusel.js";

  const grilla = document.getElementById("grilla");
  const vacio = document.getElementById("sin-resultados");
  const formBuscar = document.querySelector<HTMLFormElement>("[data-menu-buscar]");
  const recuento = document.querySelector("[data-recuento]");
  const portada = document.getElementById("vista-portada");
  const vistaGrilla = document.getElementById("vista-grilla");
  const categoriaNombre = document.getElementById("categoria-nombre");
  const volver = document.querySelector<HTMLAnchorElement>("[data-volver]");

  if (grilla && portada && vistaGrilla && categoriaNombre) {
    /* `.contents` en el envoltorio dejaría la tarjeta sin contenedor propio para
       esconder, así que se marca la tarjeta misma con la categoría y el nombre. */
    const tarjetas = Array.from(grilla.children) as HTMLElement[];
    tarjetas.forEach((envoltorio) => {
      const cat = envoltorio.getAttribute("data-categoria");
      const articulo = envoltorio.querySelector("article");
      if (cat && articulo) articulo.setAttribute("data-categoria", cat);
    });

    const NOMBRES: Record<string, string> = {
      todo: "Todo",
      unas: "Uñas",
      herramientas: "Herramientas",
      pestanas: "Pestañas y cejas",
      facial: "Cuidado facial",
      cuerpo: "Cuerpo y spa",
    };

    let categoriaActual = "todo";
    let textoBusqueda = ""; // en minúsculas, para comparar
    let textoMostrado = ""; // tal como se escribió, para el rótulo

    function aplicarFiltros() {
      let visibles = 0;

      for (const envoltorio of tarjetas) {
        const articulo = envoltorio.querySelector<HTMLElement>("article");
        const coincideCategoria =
          categoriaActual === "todo" || envoltorio.dataset.categoria === categoriaActual;
        const nombre = (articulo?.dataset.nombre ?? "").toLowerCase();
        const coincideTexto = !textoBusqueda || nombre.includes(textoBusqueda);
        const coincide = coincideCategoria && coincideTexto;
        envoltorio.classList.toggle("hidden", !coincide);
        envoltorio.classList.toggle("contents", coincide);
        if (coincide) visibles++;
      }

      vacio?.classList.toggle("hidden", visibles > 0);

      const etiqueta = textoBusqueda
        ? `"${textoMostrado}"`
        : (NOMBRES[categoriaActual] ?? categoriaActual);
      const unidad = visibles === 1 ? "producto" : "productos";
      categoriaNombre!.textContent = `${etiqueta} · ${visibles} ${unidad}`;

      if (recuento) {
        recuento.textContent = textoBusqueda
          ? `${visibles} ${visibles === 1 ? "resultado" : "resultados"} para "${textoMostrado}".`
          : `${visibles} ${visibles === 1 ? "pieza" : "piezas"} en ${NOMBRES[categoriaActual] ?? categoriaActual}.`;
      }

      const url = new URL(location.href);
      if (categoriaActual === "todo") url.searchParams.delete("categoria");
      else url.searchParams.set("categoria", categoriaActual);
      if (textoBusqueda) url.searchParams.set("buscar", textoMostrado);
      else url.searchParams.delete("buscar");
      history.replaceState(null, "", url);
    }

    function mostrarGrilla(cat: string) {
      categoriaActual = NOMBRES[cat] ? cat : "todo";
      textoBusqueda = "";
      textoMostrado = "";
      portada!.hidden = true;
      vistaGrilla!.hidden = false;
      aplicarFiltros();
      vistaGrilla!.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function mostrarPortada() {
      vistaGrilla!.hidden = true;
      portada!.hidden = false;
      textoBusqueda = "";
      textoMostrado = "";
      categoriaActual = "todo";
      /* Deja la dirección limpia (sin ?categoria= ni ?buscar=): si se recarga
         o se comparte, se abre la portada y no la última búsqueda. */
      aplicarFiltros();
      portada!.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /* Por delegación y no una por tarjeta: el carrusel agrega copias de las
       tarjetas para dar la vuelta sin fin, y esas copias también se tocan. */
    portada.addEventListener("click", (e) => {
      const tile = (e.target as Element).closest<HTMLAnchorElement>("[data-categoria-tile]");
      if (!tile) return;
      e.preventDefault();
      mostrarGrilla(tile.dataset.categoriaTile ?? "todo");
    });

    volver?.addEventListener("click", (e) => {
      e.preventDefault();
      mostrarPortada();
    });

    /* «Ver catálogo» y las categorías del menú: aquí en la portada se
       resuelven sin recargar la página (en las demás páginas, el enlace
       normal lleva a /?categoria=… y la portada se abre ya filtrada). */
    document.addEventListener("click", (e) => {
      const a = (e.target as Element).closest?.<HTMLAnchorElement>("a[data-ver-portada], a[data-ir-categoria]");
      if (!a) return;
      e.preventDefault();
      document.querySelector<HTMLDialogElement>("dialog[data-menu]")?.close();
      if (a.dataset.irCategoria) mostrarGrilla(a.dataset.irCategoria);
      else mostrarPortada();
    });

    /* Búsqueda: en todas las categorías, resultados en la grilla. */
    function buscar(texto: string) {
      textoMostrado = texto.trim();
      textoBusqueda = textoMostrado.toLowerCase();
      categoriaActual = "todo";
      portada!.hidden = true;
      vistaGrilla!.hidden = false;
      aplicarFiltros();
      vistaGrilla!.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /* El buscador del menú: aquí en la portada se resuelve sin recargar (en
       las demás páginas el formulario lleva a /?buscar=…). */
    formBuscar?.addEventListener("submit", (e) => {
      const texto = (new FormData(formBuscar).get("buscar") ?? "").toString().trim();
      e.preventDefault();
      if (!texto) return;
      document.querySelector<HTMLDialogElement>("dialog[data-menu]")?.close();
      buscar(texto);
    });

    /* Si se llega con ?categoria=unas desde un enlace compartido, se abre
       directo en la grilla de esa categoría, sin pasar por la portada. */
    const params = new URL(location.href).searchParams;
    const inicial = params.get("categoria");
    const buscado = (params.get("buscar") ?? "").trim();
    if (buscado) {
      buscar(buscado);
    } else if (inicial && NOMBRES[inicial]) {
      mostrarGrilla(inicial);
    } else {
      portada!.hidden = false;
      vistaGrilla!.hidden = true;
      aplicarFiltros();
    }

    /* Desde aquí manda el atributo hidden; la regla del primer pintado sobra. */
    delete document.documentElement.dataset.vistaInicial;
  }
</script>
