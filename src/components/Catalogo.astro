---
/**
 * Catálogo — buscador y categoría desplegable sobre una sola grilla.
 *
 * Con 35 productos no hace falta paginación: todo cabe en el mismo panel. El
 * buscador y la categoría solo esconden y muestran tarjetas que ya están en el
 * HTML, así que filtrar es instantáneo y funciona igual si el JavaScript no
 * llega a cargar (sin JS se ven las 35, que es un estado correcto).
 *
 * La categoría era antes una fila de pestañas siempre visible. En el ancho de
 * un teléfono, cuatro pestañas más un buscador no caben sin recortarse — así
 * que la categoría se volvió un desplegable de un solo botón: dos controles
 * cortos en vez de una fila que no entra en pantalla.
 *
 * Una sola columna en el teléfono: con dos columnas, una pieza con muchos
 * tonos empuja la tarjeta muy por debajo de sus vecinas y el conjunto se ve
 * descuadrado. Una columna deja cada foto grande y cada tarjeta a su propia
 * altura, sin arrastrar a la de al lado.
 *
 * Orden: destacados primero, luego consumidora antes que uso profesional dentro
 * de cada categoría. El recorrido por defecto es el de Rebeca.
 */

import TarjetaProducto from "./TarjetaProducto.astro";
import Icono from "./Icono.astro";
import productos from "../data/productos.json";
import tienda from "../data/tienda.json";

const CATEGORIAS = [
  { id: "todo", texto: "Todo", icono: "todo" as const },
  { id: "unas", texto: "Uñas", icono: "unas" as const },
  { id: "facial", texto: "Cuidado facial", icono: "facial" as const },
  { id: "cuerpo", texto: "Cuerpo y spa", icono: "cuerpo" as const },
];

/* El aviso de que esto es una muestra vive en dos momentos, no uno:
   arriba, una línea corta, solo para que nadie confunda la selección con el
   inventario completo. Abajo, después de recorrer la grilla entera, el
   argumento con el número real — que es cuando de verdad importa, porque es
   el momento en que quien no encontró lo suyo decide si pregunta o se va. El
   enlace no abre el chat en blanco: llega con el mensaje ya escrito. */
const enlaceListaCompleta = tienda.whatsapp
  ? `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(
      "Hola Coquetas Store, quiero ver la lista completa de productos disponibles."
    )}`
  : null;
---

<section id="catalogo" class="scroll-mt-2">
  <div class="contenedor pt-4 md:pt-6">
    <h1 class="t-h2 text-ciruela">Catálogo</h1>

    <p class="t-lead mt-2 text-ciruela/80">Una muestra de nuestras piezas favoritas.</p>
  </div>

  <div
    class="sticky top-0 z-20 mt-4 bg-crema py-1 after:pointer-events-none after:absolute after:inset-x-0 after:top-full after:h-4 after:bg-gradient-to-b after:from-crema after:to-transparent"
  >
    <div class="contenedor flex items-center gap-2">
      {/* ── Buscador ──────────────────────────────────────────────────── */}
      <div class="relative min-w-0 flex-1">
        <Icono
          nombre="buscar"
          tamano={17}
          class="pointer-events-none absolute top-1/2 left-2 -translate-y-1/2 text-ciruela/45"
        />
        <input
          type="search"
          inputmode="search"
          autocomplete="off"
          data-buscador
          placeholder="Buscar un producto"
          aria-label="Buscar un producto por nombre"
          class="t-cuerpo min-h-[44px] w-full border border-ciruela/25 bg-papel py-2 pr-3 pl-8 text-ciruela placeholder:text-ciruela/45 focus-visible:outline-none"
        />
      </div>

      {/* ── Categoría desplegable ─────────────────────────────────────── */}
      <div class="relative shrink-0" data-categoria-caja>
        <button
          type="button"
          id="categoria-activa"
          data-categoria-boton
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls="lista-categorias"
          class="presionable t-etiqueta inline-flex min-h-[44px] items-center gap-1 border border-ciruela/25 bg-papel px-2 text-ciruela md:px-3"
        >
          <span class="inline-flex shrink-0" aria-hidden="true">
            {
              CATEGORIAS.map((c) => (
                <Icono
                  nombre={c.icono}
                  tamano={16}
                  data-icono-de={c.id}
                  class={c.id === "todo" ? "" : "hidden"}
                />
              ))
            }
          </span>
          <span data-categoria-texto class="hidden sm:inline">
            Todo
          </span>
          <Icono
            nombre="chevron"
            tamano={14}
            data-categoria-flecha
            class="shrink-0 transition-transform duration-[var(--paso-rapido)] ease-[var(--curva)]"
          />
        </button>

        <ul
          role="listbox"
          id="lista-categorias"
          aria-labelledby="categoria-activa"
          data-categoria-lista
          tabindex="-1"
          hidden
          class="absolute right-0 z-30 mt-1 w-[220px] border border-ciruela/15 bg-papel py-1 shadow-[0_8px_24px_rgba(43,10,38,0.18)] focus:outline-none"
        >
          {
            CATEGORIAS.map((c) => (
              <li
                role="option"
                id={`opcion-${c.id}`}
                data-categoria-opcion={c.id}
                aria-selected={c.id === "todo"}
                class="t-etiqueta flex min-h-[44px] cursor-pointer items-center gap-2 px-3 text-ciruela/80 aria-selected:text-ciruela aria-selected:font-semibold"
              >
                <Icono nombre={c.icono} tamano={16} class="shrink-0" />
                <span data-opcion-texto>{c.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="contenedor mt-3">
    {/* Un solo panel gobernado por buscador + categoría: aria-labelledby
        apunta al botón de categoría, cuyo texto visible cambia con la
        selección, y el script lo mantiene al día. */}
    <div
      id="grilla"
      role="region"
      aria-labelledby="categoria-activa"
      class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-2 md:grid-cols-3 md:gap-3 lg:grid-cols-4"
    >
      {
        productos.map((p, i) => (
          <div data-categoria={p.categoria} class="contents">
            <TarjetaProducto producto={p} prioridad={i < 4} />
          </div>
        ))
      }
    </div>

    <p
      id="sin-resultados"
      class="t-cuerpo mt-6 hidden text-center text-ciruela/70"
      role="status"
    >
      No hay piezas que coincidan.
    </p>

    {/* Sin esto, quien usa lector de pantalla filtra o busca y no sabe si
        pasó algo ni cuántas piezas quedaron. */}
    <p class="sr-only" role="status" aria-live="polite" data-recuento></p>
  </div>

  {/* Cierre del catálogo: el argumento completo llega cuando ya se vio todo,
      no antes de empezar a mirar. */}
  <div class="contenedor mt-10">
    <div class="mx-auto flex max-w-[38ch] flex-col items-center gap-3 border-t border-ciruela/15 pt-8 text-center">
      <p class="t-cuerpo text-ciruela/80">
        Esta es apenas una muestra. Pregúntanos por WhatsApp y te enviamos la
        lista completa: más de 200 productos disponibles.
      </p>
      {
        enlaceListaCompleta && (
          <a
            href={enlaceListaCompleta}
            target="_blank"
            rel="noopener"
            class="presionable t-etiqueta inline-flex min-h-[48px] items-center gap-1 bg-magenta px-4 text-crema transition-colors duration-[var(--paso)] hover:bg-purpura"
          >
            Pedir la lista completa
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import "../scripts/tarjetas.js";

  const grilla = document.getElementById("grilla");
  const vacio = document.getElementById("sin-resultados");
  const buscador = document.querySelector<HTMLInputElement>("[data-buscador]");
  const recuento = document.querySelector("[data-recuento]");

  const caja = document.querySelector<HTMLElement>("[data-categoria-caja]");
  const boton = document.querySelector<HTMLButtonElement>("[data-categoria-boton]");
  const lista = document.querySelector<HTMLUListElement>("[data-categoria-lista]");
  const flecha = document.querySelector<HTMLElement>("[data-categoria-flecha]");
  const textoBoton = document.querySelector<HTMLElement>("[data-categoria-texto]");
  const iconosBoton = document.querySelectorAll<HTMLElement>("[data-icono-de]");

  if (grilla && buscador && caja && boton && lista && flecha && textoBoton) {
    /* `.contents` en el envoltorio dejaría la tarjeta sin contenedor propio para
       esconder, así que se marca la tarjeta misma con la categoría y el nombre. */
    const tarjetas = Array.from(grilla.children) as HTMLElement[];
    tarjetas.forEach((envoltorio) => {
      const cat = envoltorio.getAttribute("data-categoria");
      const articulo = envoltorio.querySelector("article");
      if (cat && articulo) articulo.setAttribute("data-categoria", cat);
    });

    const NOMBRES: Record<string, string> = {
      todo: "Todo",
      unas: "Uñas",
      facial: "Cuidado facial",
      cuerpo: "Cuerpo y spa",
    };

    let categoriaActual = "todo";
    let textoBusqueda = "";

    function aplicarFiltros() {
      let visibles = 0;

      for (const envoltorio of tarjetas) {
        const articulo = envoltorio.querySelector<HTMLElement>("article");
        const coincideCategoria =
          categoriaActual === "todo" || envoltorio.dataset.categoria === categoriaActual;
        const nombre = (articulo?.dataset.nombre ?? "").toLowerCase();
        const coincideTexto = !textoBusqueda || nombre.includes(textoBusqueda);
        const coincide = coincideCategoria && coincideTexto;
        envoltorio.classList.toggle("hidden", !coincide);
        envoltorio.classList.toggle("contents", coincide);
        if (coincide) visibles++;
      }

      vacio?.classList.toggle("hidden", visibles > 0);

      if (recuento) {
        recuento.textContent = textoBusqueda
          ? `${visibles} ${visibles === 1 ? "resultado" : "resultados"} para "${buscador.value.trim()}".`
          : `${visibles} ${visibles === 1 ? "pieza" : "piezas"} en ${NOMBRES[categoriaActual] ?? categoriaActual}.`;
      }

      const url = new URL(location.href);
      if (categoriaActual === "todo") url.searchParams.delete("categoria");
      else url.searchParams.set("categoria", categoriaActual);
      history.replaceState(null, "", url);
    }

    buscador.addEventListener("input", () => {
      textoBusqueda = buscador.value.trim().toLowerCase();
      aplicarFiltros();
    });

    /* ── Categoría desplegable ─────────────────────────────────────────── */

    const opciones = Array.from(lista.querySelectorAll<HTMLLIElement>('[role="option"]'));
    let activo = 0;

    function resaltar(i: number) {
      activo = (i + opciones.length) % opciones.length;
      lista!.setAttribute("aria-activedescendant", opciones[activo].id);
      opciones.forEach((o, idx) => o.classList.toggle("bg-crema", idx === activo));
    }

    function abrir() {
      lista!.hidden = false;
      boton!.setAttribute("aria-expanded", "true");
      flecha!.style.transform = "rotate(180deg)";
      const i = opciones.findIndex((o) => o.dataset.categoriaOpcion === categoriaActual);
      resaltar(i === -1 ? 0 : i);
      lista!.focus();
      document.addEventListener("click", alClicFuera);
    }

    function cerrar(devolverFoco: boolean) {
      lista!.hidden = true;
      boton!.setAttribute("aria-expanded", "false");
      flecha!.style.transform = "";
      document.removeEventListener("click", alClicFuera);
      if (devolverFoco) boton!.focus();
    }

    function alClicFuera(e: MouseEvent) {
      if (!(e.target instanceof Node)) return;
      if (!caja!.contains(e.target)) cerrar(false);
    }

    /* Elige sin abrir ni mover el foco: la usan el clic, el teclado y el
       enlace profundo (?categoria=), que no debe robarle el foco a la página
       al cargar. */
    function seleccionar(i: number) {
      const opcion = opciones[i];
      const cat = opcion.dataset.categoriaOpcion!;
      categoriaActual = cat;

      opciones.forEach((o, idx) => o.setAttribute("aria-selected", String(idx === i)));
      textoBoton!.textContent = opcion.querySelector("[data-opcion-texto]")?.textContent ?? "";
      iconosBoton.forEach((el) => el.classList.toggle("hidden", el.dataset.iconoDe !== cat));

      aplicarFiltros();
    }

    boton.addEventListener("click", () => {
      if (lista!.hidden) abrir();
      else cerrar(true);
    });

    boton.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        if (lista!.hidden) {
          e.preventDefault();
          abrir();
        }
      }
    });

    lista.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        resaltar(activo + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        resaltar(activo - 1);
      } else if (e.key === "Home") {
        e.preventDefault();
        resaltar(0);
      } else if (e.key === "End") {
        e.preventDefault();
        resaltar(opciones.length - 1);
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        seleccionar(activo);
        cerrar(true);
      } else if (e.key === "Escape") {
        e.preventDefault();
        cerrar(true);
      } else if (e.key === "Tab") {
        cerrar(false);
      }
    });

    opciones.forEach((o, i) => {
      o.addEventListener("click", () => {
        seleccionar(i);
        cerrar(true);
      });
      o.addEventListener("mouseenter", () => resaltar(i));
    });

    /* Si se llega con ?categoria=unas desde un enlace compartido */
    const inicial = new URL(location.href).searchParams.get("categoria");
    const iInicial = inicial ? opciones.findIndex((o) => o.dataset.categoriaOpcion === inicial) : -1;
    if (iInicial !== -1) seleccionar(iInicial);
    else aplicarFiltros();
  }
</script>
