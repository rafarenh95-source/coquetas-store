---
/**
 * Catálogo en forma de app de pedidos.
 *
 * Arriba, las categorías de verdad. En la portada, Destacados (los productos
 * marcados como destacados) y una fila corta de cada categoría. Al elegir una
 * categoría o buscar, se abre la lista completa.
 *
 * Sin JavaScript se ven la portada y la grilla a la vez: ningún producto queda
 * inalcanzable.
 */

import TarjetaProducto from "./TarjetaProducto.astro";
import Icono from "./Icono.astro";
import productos from "../data/productos.json";
import tienda from "../data/tienda.json";

const CATEGORIAS_BASE = [
  { id: "unas", texto: "Uñas", icono: "unas" as const },
  { id: "herramientas", texto: "Herramientas", icono: "herramientas" as const },
  { id: "pestanas", texto: "Pestañas y cejas", icono: "pestanas" as const },
  { id: "facial", texto: "Cuidado facial", icono: "facial" as const },
  { id: "maquillaje", texto: "Maquillaje", icono: "maquillaje" as const },
  { id: "cuerpo", texto: "Cuerpo y spa", icono: "cuerpo" as const },
  { id: "cabello", texto: "Cabello", icono: "cabello" as const },
];

const CATEGORIAS = CATEGORIAS_BASE.map((c) => {
  const deLaCategoria = productos.filter((p) => p.categoria === c.id);
  return { ...c, cantidad: deLaCategoria.length, muestra: deLaCategoria.slice(0, 8) };
});

const destacados = productos.filter((p) => p.destacado);

const NOMBRES: Record<string, string> = {
  todo: "Todo",
  unas: "Uñas",
  herramientas: "Herramientas",
  pestanas: "Pestañas y cejas",
  facial: "Cuidado facial",
  maquillaje: "Maquillaje",
  cuerpo: "Cuerpo y spa",
  cabello: "Cabello",
};
---

<section id="catalogo" class="scroll-mt-2">
  <script is:inline define:vars={{ validas: Object.keys(NOMBRES) }}>
    var params = new URLSearchParams(location.search);
    var inicial = params.get("categoria");
    var buscando = (params.get("buscar") || "").trim();
    document.documentElement.dataset.vistaInicial =
      buscando || (inicial && validas.indexOf(inicial) > -1) ? "grilla" : "portada";
  </script>

  <h1 class="sr-only">Catálogo de Coquetas Store</h1>

  <div class="contenedor pt-3">
    <p class="inline-flex items-center gap-2 rounded-2xl bg-[#fdeef3] px-3 py-2 font-sans text-[13px] font-semibold text-purpura">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle>
        <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <span>{tienda.ciudad}, Zulia · Lun–Sáb 8:30–5:00</span>
    </p>
  </div>

  <div id="vista-portada" class="contenedor mt-4">
    <div class="sin-riel -mx-[var(--sangria)] flex gap-3 overflow-x-auto px-[var(--sangria)] pb-1">
      {
        CATEGORIAS.map((c) => (
          <a
            href={`/?categoria=${c.id}`}
            data-categoria-tile={c.id}
            data-chip={c.id}
            class="presionable flex w-[76px] shrink-0 flex-col items-center gap-1 text-center"
          >
            <span class="flex h-[64px] w-[64px] items-center justify-center rounded-full bg-papel text-magenta shadow-[0_0_0_1px_rgba(43,10,38,0.08)]">
              <Icono nombre={c.icono} tamano={26} />
            </span>
            <span class="font-sans text-[12px] leading-tight font-semibold text-ciruela">{c.texto}</span>
          </a>
        ))
      }
    </div>

    {
      destacados.length > 0 && (
        <div class="mt-6">
          <div class="mb-2 flex flex-wrap items-end justify-between gap-2">
            <h2 class="font-didot text-[24px] leading-tight text-ciruela">Destacados</h2>
            <p class="hidden font-sans text-[12px] text-ciruela/70" data-bs-tasa-linea>
              <span data-bs-tasa />
            </p>
          </div>
          <p class="mb-3 max-w-[46ch] font-sans text-[13px] leading-snug text-ciruela/70">
            El precio grande es en divisa. El de abajo es pagando en bolívares, y el monto en Bs usa la tasa BCV del día.
          </p>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 min-[1440px]:grid-cols-4">
            {destacados.map((p, i) => (
              <TarjetaProducto producto={p} prioridad={i < 2} />
            ))}
          </div>
        </div>
      )
    }

    {
      CATEGORIAS.map((c) => (
        <div class="mt-7">
          <div class="mb-2 flex items-baseline justify-between gap-2">
            <h2 class="font-didot text-[24px] leading-tight text-ciruela">{c.texto}</h2>
            <a
              href={`/?categoria=${c.id}`}
              data-categoria-tile={c.id}
              data-chip={c.id}
              class="presionable inline-flex min-h-[44px] items-center font-sans text-[13px] font-semibold text-purpura"
            >
              Ver todo
            </a>
          </div>
          <div class="sin-riel -mx-[var(--sangria)] flex gap-3 overflow-x-auto px-[var(--sangria)] pb-1">
            {c.muestra.map((p) => (
              <div class="w-[168px] shrink-0">
                <TarjetaProducto producto={p} sizes="168px" />
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <div id="vista-grilla" class="contenedor mt-4 scroll-mt-[180px]">
    <div class="sin-riel -mx-[var(--sangria)] flex gap-2 overflow-x-auto px-[var(--sangria)] pb-2">
      {
        CATEGORIAS.map((c) => (
          <a
            href={`/?categoria=${c.id}`}
            data-chip={c.id}
            class="chip presionable inline-flex min-h-[44px] shrink-0 items-center gap-1 rounded-full bg-papel px-3 font-sans text-[14px] font-semibold text-ciruela/80 shadow-[0_0_0_1px_rgba(43,10,38,0.08)]"
          >
            {c.texto}
            <small class="font-medium text-ciruela/50">{c.cantidad}</small>
          </a>
        ))
      }
    </div>

    <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
      <div>
        <a
          href="/"
          data-volver
          class="presionable inline-flex min-h-[44px] items-center font-sans text-[13px] font-semibold text-purpura"
        >
          Inicio
        </a>
        <h2 id="categoria-nombre" class="font-didot text-[24px] leading-tight text-ciruela">
          Todo · {productos.length} productos
        </h2>
      </div>
      <div data-orden class="inline-flex rounded-xl bg-papel p-1 shadow-[0_0_0_1px_rgba(43,10,38,0.08)]" role="group" aria-label="Ordenar">
        <button type="button" data-orden-modo="az" aria-pressed="true" class="presionable min-h-[44px] rounded-lg px-3 font-sans text-[14px] font-semibold">
          A–Z
        </button>
        <button type="button" data-orden-modo="precio" aria-pressed="false" class="presionable min-h-[44px] rounded-lg px-3 font-sans text-[14px] font-semibold text-ciruela/60">
          Precio
        </button>
      </div>
    </div>

    <p class="mt-1 hidden font-sans text-[12px] text-ciruela/70" data-bs-tasa-linea>
      <span data-bs-tasa />
    </p>

    <div
      id="grilla"
      role="region"
      aria-labelledby="categoria-nombre"
      class="modo-lista mt-3 flex flex-col gap-2"
    >
      {
        productos.map((p) => (
          <div data-categoria={p.categoria} data-nombre={p.nombre} data-precio={p.precio_divisa}>
            <TarjetaProducto producto={p} />
          </div>
        ))
      }
    </div>

    <p id="sin-resultados" class="mt-6 hidden text-center font-sans text-[16px] text-ciruela/70" role="status">
      No hay piezas que coincidan.
    </p>
    <p class="sr-only" role="status" aria-live="polite" data-recuento></p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-2 border-t border-ciruela/10 pt-6">
      <a
        href="#vista-grilla"
        data-subir
        class="presionable inline-flex min-h-[48px] items-center gap-1 rounded-2xl border border-ciruela/25 px-4 font-sans text-[14px] font-semibold text-ciruela"
      >
        <Icono nombre="chevron" tamano={14} class="rotate-180" />
        Volver arriba
      </a>
      <a
        href="/"
        data-volver
        class="presionable inline-flex min-h-[48px] items-center px-4 font-sans text-[14px] font-semibold text-purpura"
      >
        Ver otras categorías
      </a>
    </div>
  </div>

  <button
    type="button"
    data-subir
    data-subir-flotante
    aria-label="Volver arriba"
    class="presionable invisible fixed bottom-[calc(16px+env(safe-area-inset-bottom))] left-[max(16px,env(safe-area-inset-left))] z-40 flex h-[48px] w-[48px] translate-y-3 items-center justify-center rounded-full border border-ciruela/15 bg-papel text-ciruela opacity-0 shadow-[0_4px_16px_rgba(43,10,38,0.16)] data-[visible]:visible data-[visible]:translate-y-0 data-[visible]:opacity-100"
  >
    <Icono nombre="chevron" tamano={22} class="rotate-180" />
  </button>
</section>

<script>
  import "../scripts/tarjetas.js";

  const grilla = document.getElementById("grilla");
  const vacio = document.getElementById("sin-resultados");
  const recuento = document.querySelector("[data-recuento]");
  const portada = document.getElementById("vista-portada");
  const vistaGrilla = document.getElementById("vista-grilla");
  const categoriaNombre = document.getElementById("categoria-nombre");
  const volveres = document.querySelectorAll<HTMLAnchorElement>("[data-volver]");
  const forms = document.querySelectorAll<HTMLFormElement>("[data-buscar]");
  const ordenGrupo = document.querySelector("[data-orden]");

  if (grilla && portada && vistaGrilla && categoriaNombre) {
    const NOMBRES: Record<string, string> = {
      todo: "Todo",
      unas: "Uñas",
      herramientas: "Herramientas",
      pestanas: "Pestañas y cejas",
      facial: "Cuidado facial",
      maquillaje: "Maquillaje",
      cuerpo: "Cuerpo y spa",
      cabello: "Cabello",
    };

    let categoriaActual = "todo";
    let textoBusqueda = "";
    let textoMostrado = "";
    let orden: "az" | "precio" = "az";

    const entradas = () => Array.from(grilla.children) as HTMLElement[];

    function pintarOrden() {
      ordenGrupo?.querySelectorAll<HTMLButtonElement>("[data-orden-modo]").forEach((b) => {
        const activo = b.dataset.ordenModo === orden;
        b.setAttribute("aria-pressed", String(activo));
        b.classList.toggle("bg-[#fdeef3]", activo);
        b.classList.toggle("text-magenta", activo);
        b.classList.toggle("text-ciruela/60", !activo);
      });
    }

    function pintarChips() {
      document.querySelectorAll<HTMLElement>("[data-chip]").forEach((c) => {
        const activo = !textoBusqueda && c.dataset.chip === categoriaActual && vistaGrilla!.hidden === false;
        c.classList.toggle("chip-on", activo);
        if (c.tagName === "A") c.setAttribute("aria-current", activo ? "true" : "false");
      });
    }

    function aplicarFiltros() {
      const lista = entradas();
      const visibles: HTMLElement[] = [];

      for (const envoltorio of lista) {
        const nombre = (envoltorio.dataset.nombre ?? "").toLowerCase();
        const coincideCategoria =
          categoriaActual === "todo" || envoltorio.dataset.categoria === categoriaActual;
        const coincideTexto = !textoBusqueda || nombre.includes(textoBusqueda);
        const coincide = coincideCategoria && coincideTexto;
        envoltorio.classList.toggle("hidden", !coincide);
        if (coincide) visibles.push(envoltorio);
      }

      const cmp = (a: HTMLElement, b: HTMLElement) => {
        if (orden === "precio") {
          const d = Number(a.dataset.precio) - Number(b.dataset.precio);
          if (d) return d;
        }
        return (a.dataset.nombre ?? "").localeCompare(b.dataset.nombre ?? "", "es");
      };
      visibles.sort(cmp);
      const ocultos = lista.filter((el) => !visibles.includes(el));
      for (const el of [...visibles, ...ocultos]) grilla!.appendChild(el);

      vacio?.classList.toggle("hidden", visibles.length > 0);
      ordenGrupo?.classList.toggle("hidden", Boolean(textoBusqueda));
      grilla!.classList.toggle("modo-lista", !textoBusqueda);
      grilla!.classList.toggle("modo-cuadricula", Boolean(textoBusqueda));

      const etiqueta = textoBusqueda ? `«${textoMostrado}»` : (NOMBRES[categoriaActual] ?? categoriaActual);
      const unidad = visibles.length === 1 ? "producto" : "productos";
      categoriaNombre!.textContent = textoBusqueda
        ? `${visibles.length} ${visibles.length === 1 ? "resultado" : "resultados"} para ${etiqueta}`
        : `${etiqueta} · ${visibles.length} ${unidad}`;

      if (recuento) {
        recuento.textContent = textoBusqueda
          ? `${visibles.length} ${visibles.length === 1 ? "resultado" : "resultados"} para "${textoMostrado}".`
          : `${visibles.length} ${visibles.length === 1 ? "pieza" : "piezas"} en ${NOMBRES[categoriaActual] ?? categoriaActual}.`;
      }

      pintarChips();
      pintarOrden();

      const url = new URL(location.href);
      if (categoriaActual === "todo" || textoBusqueda) url.searchParams.delete("categoria");
      else url.searchParams.set("categoria", categoriaActual);
      if (textoBusqueda) url.searchParams.set("buscar", textoMostrado);
      else url.searchParams.delete("buscar");
      history.replaceState(null, "", url);
    }

    function sincronizarBuscador(texto: string) {
      document.querySelectorAll<HTMLInputElement>("[data-buscar] input[name=buscar]").forEach((input) => {
        if (input.value !== texto) input.value = texto;
      });
      document.querySelectorAll<HTMLButtonElement>("[data-buscar-limpiar]").forEach((b) => {
        b.hidden = texto.trim() === "";
      });
    }

    function mostrarGrilla(cat: string, opts: { scroll?: boolean } = {}) {
      categoriaActual = NOMBRES[cat] ? cat : "todo";
      textoBusqueda = "";
      textoMostrado = "";
      sincronizarBuscador("");
      portada!.hidden = true;
      vistaGrilla!.hidden = false;
      aplicarFiltros();
      if (opts.scroll !== false) {
        const comportamiento: ScrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth";
        vistaGrilla!.scrollIntoView({ behavior: comportamiento, block: "start" });
      }
    }

    function mostrarPortada(opts: { scroll?: boolean } = {}) {
      vistaGrilla!.hidden = true;
      portada!.hidden = false;
      textoBusqueda = "";
      textoMostrado = "";
      categoriaActual = "todo";
      sincronizarBuscador("");
      aplicarFiltros();
      if (opts.scroll !== false) {
        const comportamiento: ScrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth";
        window.scrollTo({ top: 0, behavior: comportamiento });
      }
    }

    function buscar(texto: string, opts: { scroll?: boolean } = {}) {
      textoMostrado = texto.trim();
      textoBusqueda = textoMostrado.toLowerCase();
      categoriaActual = "todo";
      sincronizarBuscador(textoMostrado);
      portada!.hidden = true;
      vistaGrilla!.hidden = false;
      aplicarFiltros();
      if (opts.scroll !== false) {
        const comportamiento: ScrollBehavior = window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth";
        vistaGrilla!.scrollIntoView({ behavior: comportamiento, block: "start" });
      }
    }

    portada.addEventListener("click", (e) => {
      const tile = (e.target as Element).closest<HTMLElement>("[data-categoria-tile]");
      if (!tile) return;
      e.preventDefault();
      mostrarGrilla(tile.dataset.categoriaTile ?? tile.dataset.chip ?? "todo");
    });

    vistaGrilla.addEventListener("click", (e) => {
      const chip = (e.target as Element).closest<HTMLElement>("[data-chip]");
      if (!chip || chip.hasAttribute("data-categoria-tile")) return;
      e.preventDefault();
      mostrarGrilla(chip.dataset.chip ?? "todo");
    });

    volveres.forEach((volver) =>
      volver.addEventListener("click", (e) => {
        e.preventDefault();
        mostrarPortada();
      })
    );

    ordenGrupo?.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("[data-orden-modo]");
      if (!b) return;
      orden = b.dataset.ordenModo === "precio" ? "precio" : "az";
      aplicarFiltros();
    });

    const sinMovimiento = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function subir() {
      const comportamiento: ScrollBehavior = sinMovimiento() ? "auto" : "smooth";
      if (!vistaGrilla!.hidden) {
        vistaGrilla!.scrollIntoView({ behavior: comportamiento, block: "start" });
        categoriaNombre!.setAttribute("tabindex", "-1");
        categoriaNombre!.focus({ preventScroll: true });
      } else {
        window.scrollTo({ top: 0, behavior: comportamiento });
      }
    }
    document.querySelectorAll("[data-subir]").forEach((b) =>
      b.addEventListener("click", (e) => {
        e.preventDefault();
        subir();
      })
    );

    const flotante = document.querySelector<HTMLElement>("[data-subir-flotante]");
    if (flotante) {
      let pendiente = false;
      const revisar = () => {
        pendiente = false;
        if (window.scrollY > window.innerHeight * 1.5) flotante.dataset.visible = "true";
        else delete flotante.dataset.visible;
      };
      window.addEventListener(
        "scroll",
        () => {
          if (!pendiente) {
            pendiente = true;
            requestAnimationFrame(revisar);
          }
        },
        { passive: true }
      );
      revisar();
    }

    forms.forEach((form) => {
      form.addEventListener("submit", (e) => {
        const datos = new FormData(form);
        const texto = (datos.get("buscar") ?? "").toString();
        e.preventDefault();
        if (!texto.trim()) mostrarPortada();
        else buscar(texto);
      });
      const input = form.querySelector<HTMLInputElement>("input[name=buscar]");
      input?.addEventListener("input", () => {
        const texto = input.value;
        if (!texto.trim()) mostrarPortada({ scroll: false });
        else buscar(texto, { scroll: false });
      });
    });

    document.querySelectorAll("[data-buscar-limpiar]").forEach((b) =>
      b.addEventListener("click", () => mostrarPortada())
    );

    const params = new URL(location.href).searchParams;
    const inicial = params.get("categoria");
    const buscado = (params.get("buscar") ?? "").trim();
    if (buscado) buscar(buscado, { scroll: false });
    else if (inicial && NOMBRES[inicial]) mostrarGrilla(inicial, { scroll: false });
    else {
      portada.hidden = false;
      vistaGrilla.hidden = true;
      aplicarFiltros();
    }

    delete document.documentElement.dataset.vistaInicial;
  }
</script>
