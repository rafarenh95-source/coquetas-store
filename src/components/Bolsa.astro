---
/**
 * El pedido.
 *
 * En el teléfono es una hoja que se abre desde la barra de abajo o el ícono.
 * En la computadora queda fijo a la derecha. El mensaje de WhatsApp lo arma
 * scripts/bolsa.js, igual que antes.
 */

import tienda from "../data/tienda.json";
import Icono from "./Icono.astro";
---

<div
  data-aviso
  role="status"
  aria-live="polite"
  class="group pointer-events-none fixed inset-x-0 bottom-[calc(108px+env(safe-area-inset-bottom))] z-40 flex justify-center px-3 min-[1100px]:bottom-4"
>
  <div
    class="sobre-ciruela invisible flex w-full max-w-[420px] translate-y-2 items-center gap-2 rounded-2xl py-1 pr-1 pl-3 opacity-0 shadow-[0_4px_16px_rgba(43,10,38,0.28)] transition-[opacity,transform,visibility] duration-[var(--paso-lento)] ease-[var(--curva)] group-data-[visible]:pointer-events-auto group-data-[visible]:visible group-data-[visible]:translate-y-0 group-data-[visible]:opacity-100"
  >
    <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="none" class="shrink-0">
      <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <div class="min-w-0 flex-1 py-1">
      <p data-aviso-titulo class="font-sans text-[15px] leading-tight font-semibold"></p>
      <p data-aviso-detalle class="font-sans text-[12px] leading-snug text-crema/80"></p>
    </div>
    <button
      type="button"
      data-aviso-ver
      class="presionable inline-flex min-h-[44px] shrink-0 items-center px-2 font-sans text-[14px] font-semibold underline decoration-1 underline-offset-2"
    >
      Ver pedido
    </button>
  </div>
</div>

<div
  data-barra-pedido
  hidden
  class="fixed inset-x-3 bottom-[max(12px,env(safe-area-inset-bottom))] z-30 min-[1100px]:hidden"
>
  <div class="flex h-[62px] items-center gap-3 rounded-2xl bg-magenta px-3 text-crema shadow-[0_12px_28px_rgba(197,24,138,0.35)]">
    <div
      data-bolsa-cuenta
      class="grid h-[38px] min-w-[38px] place-items-center rounded-xl bg-white/15 font-sans text-[15px] font-extrabold tabular-nums"
    >
      0
    </div>
    <div class="min-w-0 leading-tight">
      <p data-barra-piezas class="font-sans text-[12px] text-crema">0 productos</p>
      <p data-barra-divisa class="font-sans text-[17px] font-extrabold tabular-nums">$0,00</p>
    </div>
    <button
      type="button"
      data-bolsa-abrir
      class="presionable ml-auto inline-flex h-[44px] items-center gap-1 rounded-xl bg-papel px-3 font-sans text-[14px] font-bold text-magenta"
    >
      Ver pedido
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
        <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</div>

<div
  data-bolsa-panel
  inert
  class="bolsa-panel pointer-events-none fixed inset-0 z-50 overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Tu pedido"
>
  <div data-bolsa-fondo class="pointer-events-auto absolute inset-0 bg-ciruela/40 opacity-0"></div>

  <aside
    data-hoja
    style="transform: translateX(100%)"
    class="pointer-events-auto absolute inset-y-0 right-0 flex w-full max-w-[420px] touch-pan-y flex-col bg-[#fffaf7] will-change-transform"
  >
    <div class="flex items-center justify-between px-4 pt-[max(16px,env(safe-area-inset-top))] pb-2">
      <h2 class="font-didot text-[24px] leading-tight text-ciruela">Tu pedido</h2>
      <div class="flex items-center gap-2">
        <p data-bolsa-piezas class="font-sans text-[13px] font-semibold text-ciruela/60">0 productos</p>
        <button
          type="button"
          data-bolsa-cerrar
          aria-label="Cerrar el pedido"
          class="presionable inline-flex h-[44px] w-[44px] items-center justify-center rounded-xl bg-papel text-ciruela shadow-[0_0_0_1px_rgba(43,10,38,0.08)] min-[1100px]:hidden"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none">
            <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div data-bolsa-desplazable class="flex-1 overflow-y-auto px-4">
      <p data-bolsa-vacia class="py-6 font-sans text-[16px] leading-snug text-ciruela/70">
        Todavía no has agregado nada. Elige un producto y toca el botón magenta.
      </p>
      <ul data-bolsa-lista class="flex flex-col"></ul>
    </div>

    <div
      data-bolsa-resumen
      class="hidden border-t border-ciruela/10 px-4 pt-3 pb-[max(16px,env(safe-area-inset-bottom))]"
    >
      <div class="flex items-end justify-between gap-3">
        <div>
          <p class="font-sans text-[13px] text-ciruela/60">Total en divisa</p>
          <p data-bolsa-bolivares class="mt-1 font-sans text-[13px] font-semibold text-ciruela/80 tabular-nums"></p>
          <p class="mt-1 hidden font-sans text-[12px] text-ciruela/60" data-bs-tasa-linea>
            <span data-bs-tasa />
          </p>
        </div>
        <p data-bolsa-divisa class="font-sans text-[28px] leading-none font-extrabold text-ciruela tabular-nums">$0,00</p>
      </div>

      <p class="mt-3 font-sans text-[11px] font-bold tracking-wide text-ciruela/50 uppercase">Vista previa del mensaje</p>
      <div class="mt-2 rounded-2xl bg-[#efeae2] p-2">
        <p
          data-bolsa-preview
          class="ml-3 rounded-xl rounded-br-sm bg-[#d9fdd3] p-2 font-sans text-[12px] leading-snug whitespace-pre-wrap text-[#111b21]"
        ></p>
      </div>

      {
        tienda.whatsapp ? (
          <a
            data-bolsa-pedir
            data-whatsapp={tienda.whatsapp}
            href={`https://wa.me/${tienda.whatsapp}`}
            class="presionable mt-3 flex min-h-[52px] w-full items-center justify-center gap-2 rounded-2xl bg-magenta px-3 font-sans text-[16px] font-bold text-crema"
          >
            <Icono nombre="whatsapp" tamano={20} />
            Enviar pedido por WhatsApp
          </a>
        ) : (
          <button
            type="button"
            data-bolsa-copiar
            class="presionable relative mt-3 flex min-h-[52px] w-full items-center justify-center rounded-2xl bg-magenta px-3 font-sans text-[16px] font-bold text-crema"
          >
            Copiar el pedido
            <span
              data-bolsa-copiado
              class="absolute inset-0 hidden items-center justify-center rounded-2xl bg-purpura text-crema [&:not(.hidden)]:flex"
            >
              Copiado
            </span>
          </button>
        )
      }

      <p class="mt-2 text-center font-sans text-[12px] text-ciruela/60">
        El monto final en bolívares se calcula con la tasa del día del pago.
      </p>
    </div>
  </aside>
</div>
