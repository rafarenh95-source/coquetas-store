---
/**
 * Pie de página: preguntas frecuentes, contacto y la línea legal.
 *
 * Todas las preguntas empiezan cerradas: cada quien abre la que le interesa
 * (decisión de la dueña). «Cómo comprar» va primera porque es la duda que más
 * frena la compra (manual §4, «no saber cuándo llega el pedido»); sus tres
 * pasos dicen qué pasa después de escribir, no solo dónde. El enlace «Cómo
 * comprar» del menú lleva aquí y sí la abre, porque eso es lo que se pidió.
 *
 * Los textos viven en src/data/preguntas.json (la dueña puede corregirlos ahí).
 * Los mismos textos salen como datos estructurados FAQPage en la portada.
 *
 * Acordeón nativo (<details name>): se abre con el dedo, con Enter o Espacio,
 * el lector de pantalla lo anuncia como expandible, y con «name» solo queda
 * una respuesta abierta a la vez. Cero JavaScript para funcionar.
 *
 * La línea legal sobre la tasa BCV no es adorno: la Ley de Precios Justos obliga
 * a expresar el precio según la tasa oficial vigente.
 */

import tienda from "../data/tienda.json";
import preguntas from "../data/preguntas.json";
import Icono from "./Icono.astro";
import Logo from "./Logo.astro";

const whatsapp = (mensaje: string) =>
  tienda.whatsapp
    ? `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(mensaje)}`
    : null;

/* El chat no se abre en blanco: llega con el mensaje que corresponde. */
const enlaceLista = whatsapp("Hola Coquetas Store, quiero ver la lista completa de productos disponibles.");
const enlaceMayor = whatsapp("Hola Coquetas Store, quiero los precios al mayor.");
const enlaceConsulta = whatsapp("Hola Coquetas Store, tengo una pregunta.");

/* Cuando se cargue la dirección exacta, el enlace apunta a ella. Mientras
   tanto busca el negocio por nombre y ciudad, que ya deja a la clienta en la
   zona correcta en vez de en ningún sitio. */
const consultaMapa = tienda.direccion
  ? `${tienda.direccion}, ${tienda.ciudad}, ${tienda.estado}, Venezuela`
  : `${tienda.nombre}, ${tienda.ciudad}, ${tienda.estado}, Venezuela`;

const enlaceMapa =
  tienda.mapa ??
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(consultaMapa)}`;

const pasos = [
  { icono: "elegir" as const, texto: "Elige lo que quieras y agrégalo a la bolsa." },
  {
    icono: "whatsapp" as const,
    texto: "Escríbenos por WhatsApp. ¿No ves algo? Pide la lista completa.",
  },
  { icono: "confirmar" as const, texto: "Confirmamos disponibilidad y tu compra queda lista." },
];

/* Botón de contorno dentro de las respuestas: el magenta queda para la acción
   principal (manual), y seis botones magenta en una lista lo gastarían. */
const botonRespuesta =
  "presionable t-etiqueta mt-2 inline-flex min-h-[44px] items-center gap-1 border border-ciruela px-3 text-ciruela transition-colors duration-[var(--paso)] hover:bg-ciruela hover:text-crema";
---

<footer id="informacion" class="mt-10 scroll-mt-4 pb-8">
  <div class="contenedor">
    <div class="mb-4 text-center">
      <Logo version="horizontal" ancho={200} class="mx-auto" />
      <p class="mt-2 font-sans text-[13px] text-ciruela/60">
        Insumos de uñas y belleza · {tienda.ciudad}, Zulia
      </p>
    </div>

    <div class="rounded-3xl bg-papel px-4 shadow-[0_0_0_1px_rgba(43,10,38,0.08)]">
      <div class="flex gap-3 border-b border-ciruela/10 py-3">
        <span class="grid h-[44px] w-[44px] shrink-0 place-items-center rounded-xl bg-[#fdeef3] text-magenta">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </span>
        <div>
          <h2 class="font-sans text-[14px] font-bold text-ciruela">Horario</h2>
          <p class="font-sans text-[14px] leading-snug text-ciruela/80">{tienda.horario}</p>
        </div>
      </div>

      <div class="flex gap-3 border-b border-ciruela/10 py-3">
        <span class="grid h-[44px] w-[44px] shrink-0 place-items-center rounded-xl bg-[#fdeef3] text-magenta">
          <Icono nombre="ubicacion" tamano={18} />
        </span>
        <div>
          <h2 class="font-sans text-[14px] font-bold text-ciruela">Ubicación y retiro</h2>
          <p class="font-sans text-[14px] leading-snug text-ciruela/80">
            {tienda.ciudad}, {tienda.estado}. Dirección: [marcador]. Puedes retirar tu pedido en la tienda en el horario de atención.
          </p>
          <a href={enlaceMapa} target="_blank" rel="noopener" class="presionable inline-flex min-h-[44px] items-center font-sans text-[14px] font-semibold text-purpura">
            Ver en el mapa
          </a>
        </div>
      </div>

      <div class="flex gap-3 border-b border-ciruela/10 py-3">
        <span class="grid h-[44px] w-[44px] shrink-0 place-items-center rounded-xl bg-[#fdeef3] text-magenta">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
            <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.8"></rect>
            <path d="M3 10h18" stroke="currentColor" stroke-width="1.8"></path>
          </svg>
        </span>
        <div>
          <h2 class="font-sans text-[14px] font-bold text-ciruela">Formas de pago</h2>
          <p class="mt-1 flex flex-wrap gap-1">
            <span class="rounded-lg bg-[#fdeef3] px-2 py-1 font-sans text-[13px] font-semibold text-purpura">Binance</span>
            <span class="rounded-lg bg-[#fdeef3] px-2 py-1 font-sans text-[13px] font-semibold text-purpura">Pago móvil</span>
            <span class="rounded-lg bg-[#fdeef3] px-2 py-1 font-sans text-[13px] font-semibold text-purpura">Transferencia</span>
            <span class="rounded-lg bg-[#fdeef3] px-2 py-1 font-sans text-[13px] font-semibold text-purpura">Zelle</span>
            <span class="rounded-lg bg-[#fdeef3] px-2 py-1 font-sans text-[13px] font-semibold text-purpura">Efectivo</span>
          </p>
        </div>
      </div>

      <div class="flex gap-3 border-b border-ciruela/10 py-3">
        <span class="grid h-[44px] w-[44px] shrink-0 place-items-center rounded-xl bg-[#fdeef3] text-magenta">
          <Icono nombre="confirmar" tamano={18} />
        </span>
        <div>
          <h2 class="font-sans text-[14px] font-bold text-ciruela">Precios al mayor</h2>
          <p class="font-sans text-[14px] leading-snug text-ciruela/80">
            Tenemos precios especiales al mayor. Escríbenos por WhatsApp y te los enviamos.
          </p>
        </div>
      </div>

      <div class="flex gap-3 py-3">
        <span class="grid h-[44px] w-[44px] shrink-0 place-items-center rounded-xl bg-[#fdeef3] text-magenta">
          <Icono nombre="tiktok" tamano={18} />
        </span>
        <div>
          <h2 class="font-sans text-[14px] font-bold text-ciruela">Redes</h2>
          {
            tienda.tiktok ? (
              <a
                href={`https://www.tiktok.com/@${tienda.tiktok}`}
                target="_blank"
                rel="noopener"
                class="presionable inline-flex min-h-[44px] items-center font-sans text-[14px] font-semibold text-purpura"
              >
                TikTok @{tienda.tiktok}
              </a>
            ) : (
              <p class="font-sans text-[14px] text-ciruela/70">[marcador]</p>
            )
          }
        </div>
      </div>
    </div>

    {
      enlaceConsulta && (
        <a
          href={enlaceConsulta}
          target="_blank"
          rel="noopener"
          class="presionable mt-4 flex min-h-[52px] w-full items-center justify-center gap-2 rounded-2xl bg-magenta font-sans text-[16px] font-bold text-crema"
        >
          <Icono nombre="whatsapp" tamano={20} />
          Escribir por WhatsApp
        </a>
      )
    }

    <h2 id="preguntas" class="mt-10 scroll-mt-4 font-didot text-[24px] leading-tight text-ciruela">Preguntas frecuentes</h2>

    <div class="mt-3 border-t border-ciruela/15">
      {
        preguntas.map((q, i) => (
          <details
            id={q.id}
            name="preguntas-frecuentes"
            class="group scroll-mt-[84px] border-b border-ciruela/15"
          >
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-2 py-2 text-ciruela transition-colors duration-[var(--paso)] hover:text-purpura [&::-webkit-details-marker]:hidden">
              <span class="font-sans text-[16px] leading-snug font-semibold">{q.pregunta}</span>
              {/* La flecha gira al abrir: dice «esto se despliega» sin texto. */}
              <Icono
                nombre="chevron"
                tamano={16}
                class="shrink-0 text-purpura transition-transform duration-[var(--paso-lento)] ease-[var(--curva)] group-open:rotate-180"
              />
            </summary>

            <div class="pb-4">
              {q.id === "como-comprar" ? (
                /* Un ícono por paso antes que el número: se entiende el qué de
                   un vistazo, sin tener que leer la frase completa primero. */
                <ol class="grid gap-2 md:grid-cols-3 md:gap-3">
                  {pasos.map((paso, j) => (
                    <li class="bg-papel p-3">
                      <div class="flex items-center gap-2">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-crema text-purpura">
                          <Icono nombre={paso.icono} tamano={18} />
                        </span>
                        <p class="t-etiqueta text-purpura">0{j + 1}</p>
                      </div>
                      <p class="t-cuerpo mt-2 text-ciruela/85">{paso.texto}</p>
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="t-cuerpo max-w-[60ch] text-ciruela/85">{q.respuesta}</p>
              )}

              {q.id === "mas-productos" && enlaceLista && (
                <a href={enlaceLista} target="_blank" rel="noopener" class={botonRespuesta}>
                  <Icono nombre="whatsapp" tamano={16} />
                  Pedir la lista completa
                </a>
              )}

              {q.id === "ubicacion" && (
                <a href={enlaceMapa} target="_blank" rel="noopener" class={botonRespuesta}>
                  <Icono nombre="ubicacion" tamano={16} />
                  Ver en el mapa
                </a>
              )}

              {q.id === "mayor" && enlaceMayor && (
                <a href={enlaceMayor} target="_blank" rel="noopener" class={botonRespuesta}>
                  <Icono nombre="whatsapp" tamano={16} />
                  Pedir precios al mayor
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>

    {/* Cierre: lo que no está en la lista se pregunta. Aquí sí va el magenta,
        es la acción principal de la sección. */}
    <div class="mt-6 flex flex-col bg-papel p-3">
      <p class="t-etiqueta text-purpura">¿Tienes otra pregunta?</p>
      <p class="t-cuerpo mt-2 text-ciruela/85">Escríbenos por WhatsApp.</p>
      <p class="t-caption mt-1 text-ciruela/70">{tienda.promesa_respuesta}</p>

      <div class="mt-3">
        {
          enlaceConsulta ? (
            <a
              href={enlaceConsulta}
              target="_blank"
              rel="noopener"
              class="presionable t-etiqueta inline-flex min-h-[44px] items-center gap-1 bg-magenta px-3 text-crema transition-colors duration-[var(--paso)] hover:bg-purpura"
            >
              <Icono nombre="whatsapp" tamano={17} />
              Escribir por WhatsApp
            </a>
          ) : (
            <p class="t-caption max-w-[36ch] border border-ciruela/25 p-2 text-ciruela/70">
              Falta el número de WhatsApp. Se pone una sola vez en el archivo de datos de la
              tienda y aparece en todo el sitio.
            </p>
          )
        }
      </div>
    </div>

    <p class="t-legal mt-6 max-w-[70ch] text-ciruela/70">
      Precios expresados en divisa. El equivalente en bolívares se calcula con la tasa oficial
      del Banco Central de Venezuela vigente el día de la consulta, y se muestra junto a la
      fecha de esa tasa. Las existencias pueden variar; se confirman al momento del pedido.
    </p>

    <p class="t-legal mt-2 text-ciruela/70">
      © {new Date().getFullYear()} {tienda.nombre}.
    </p>
  </div>
</footer>

<script>
  /* Los enlaces «Cómo comprar» llevan a #como-comprar: si esa respuesta estaba
     cerrada, se abre al llegar. Sirve también cuando el ancla ya estaba en la
     dirección (ahí el navegador no avisa de ningún cambio). */
  function abrirDesdeAncla(hash: string) {
    const destino = hash ? document.getElementById(hash.slice(1)) : null;
    if (destino instanceof HTMLDetailsElement) destino.open = true;
  }

  document.addEventListener("click", (e) => {
    const enlace = (e.target as Element)?.closest?.<HTMLAnchorElement>('a[href*="#"]');
    if (enlace && enlace.pathname === location.pathname) abrirDesdeAncla(enlace.hash);
  });
  window.addEventListener("hashchange", () => abrirDesdeAncla(location.hash));
  abrirDesdeAncla(location.hash);
</script>
