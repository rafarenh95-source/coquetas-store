---
/**
 * Iconos de interfaz.
 *
 * Trazo de un solo tono en `currentColor`, para que hereden el color del texto
 * que acompañan y nunca introduzcan un color propio. El manual §12 pide
 * iconografía a una tinta; estos cumplen esa regla.
 *
 * El de WhatsApp es la excepción consciente: no es un icono de Coquetas sino la
 * marca de una plataforma, y se reconoce antes por su silueta que por cualquier
 * palabra. Va macizo, no de trazo, porque así es como se lee.
 *
 * `resto` recoge cualquier prop que no sea nombre/tamaño/class -- sobre todo
 * los `data-*` que el script usa para encontrar y alternar el icono correcto
 * (por ejemplo `data-icono-de`). Sin este spread, Astro no los pasa al <svg>
 * porque no están declarados explícitamente, y el script no encuentra nada.
 */

interface Props {
  nombre:
    | "whatsapp"
    | "ubicacion"
    | "buscar"
    | "chevron"
    | "todo"
    | "unas"
    | "facial"
    | "cuerpo";
  tamano?: number;
  class?: string;
  [dataAttr: string]: any;
}

const { nombre, tamano = 18, class: clase = "", ...resto } = Astro.props;
---

{
  nombre === "whatsapp" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.1-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.09-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.42h-.47c-.17 0-.44.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.13.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.6.19 1.14.16 1.57.1.48-.07 1.47-.6 1.68-1.19.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z" />
    </svg>
  )
}

{
  nombre === "ubicacion" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <path d="M20 10c0 5.25-8 12-8 12s-8-6.75-8-12a8 8 0 0 1 16 0Z" />
      <circle cx="12" cy="10" r="2.75" />
    </svg>
  )
}

{
  nombre === "buscar" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <circle cx="11" cy="11" r="7" />
      <path d="M20.5 20.5 16 16" />
    </svg>
  )
}

{
  nombre === "chevron" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  )
}

{
  nombre === "todo" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.3" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.3" />
      <rect x="13.5" y="13.5" width="7" height="7" rx="1.3" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.3" />
    </svg>
  )
}

{
  nombre === "unas" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <rect x="9" y="2.5" width="6" height="3.5" rx="1" />
      <path d="M9 6 7 9v9.5A2.5 2.5 0 0 0 9.5 21h5a2.5 2.5 0 0 0 2.5-2.5V9l-2-3" />
    </svg>
  )
}

{
  nombre === "facial" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <path d="M12 2.7 17.5 8a7.5 7.5 0 1 1-11 0Z" />
    </svg>
  )
}

{
  nombre === "cuerpo" && (
    <svg
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class={clase}
      {...resto}
    >
      <path d="M19 4C11 4 4 11 4 19c0 .5.5 1 1 1 8 0 15-7 15-15 0-.5-.5-1-1-1Z" />
      <path d="M5.5 18.5 18.5 5.5" />
    </svg>
  )
}
