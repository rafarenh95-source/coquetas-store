---
/**
 * Tarjeta compacta: foto, los dos precios y el botón de agregar.
 *
 * El botón vive fuera del enlace. Si estuviera adentro, el dedo abriría la
 * ficha cuando quería sumar el producto al pedido.
 */

import Precio from "./Precio.astro";
import Swatches from "./Swatches.astro";

interface Props {
  producto: any;
  prioridad?: boolean;
  sizes?: string;
}

const {
  producto: p,
  prioridad = false,
  sizes = "(min-width: 1100px) 220px, (min-width: 640px) 30vw, 46vw",
} = Astro.props;

const primera = p.variantes[0];
const src = primera.imagenes[0];
const srcset = [400, 550, 700]
  .map((w) => `${src.replace(".webp", `-${w}.webp`)} ${w}w`)
  .concat(`${src} 1000w`)
  .join(", ");

const conVariantes = p.variantes.length > 1;
const nombreGrupo = `${p.tipo_variante === "color" ? "Tono" : p.tipo_variante === "tamano" ? "Tamaño" : "Variante"} de ${p.nombre}`;
---

<article
  data-tarjeta
  data-id={p.producto_id}
  data-nombre={p.nombre}
  data-presentacion={p.presentacion ?? ""}
  data-precio={p.precio_divisa}
  data-referencia={p.precio_referencia}
  data-stock={p.stock ?? undefined}
  class="card-app group relative flex h-full flex-col rounded-2xl bg-papel p-2 shadow-[0_0_0_1px_rgba(43,10,38,0.08)]"
>
  <div class="card-foto relative">
    <a href={`/producto/${p.producto_id.toLowerCase()}`} class="presionable block">
      <div class="aspect-square overflow-hidden rounded-xl bg-[#fdf1ec]">
        <img
          data-foto-tarjeta
          src={src}
          srcset={srcset}
          sizes={sizes}
          alt={`${p.nombre}${p.presentacion ? ` ${p.presentacion}` : ""}`}
          width="1000"
          height="1000"
          loading={prioridad ? "eager" : "lazy"}
          fetchpriority={prioridad ? "high" : "auto"}
          decoding="async"
          class="h-full w-full object-contain p-2"
        />
      </div>
    </a>
    <button
      type="button"
      data-agregar-tarjeta
      aria-label={`Agregar ${p.nombre} al pedido`}
      class="card-mas presionable absolute right-2 bottom-2 inline-flex h-[44px] w-[44px] items-center justify-center rounded-full bg-magenta text-crema shadow-[0_4px_10px_rgba(197,24,138,0.28)] disabled:cursor-not-allowed disabled:opacity-40"
    >
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none">
        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div class="card-texto mt-2 flex min-w-0 flex-1 flex-col gap-1 px-1 pb-1">
    <a href={`/producto/${p.producto_id.toLowerCase()}`} class="flex flex-col gap-[2px]">
      <h3 class="font-sans text-[15px] leading-snug font-semibold text-ciruela">{p.nombre}</h3>
      {p.presentacion && <p class="font-sans text-[13px] leading-snug text-ciruela/60">{p.presentacion}</p>}
      <Precio divisa={p.precio_divisa} referencia={p.precio_referencia} nota={p.nota_precio} />
    </a>

    {
      conVariantes && (
        <Swatches
          variantes={p.variantes}
          tipo={p.tipo_variante}
          modo="tarjeta"
          etiqueta={nombreGrupo}
        />
      )
    }
  </div>
</article>
